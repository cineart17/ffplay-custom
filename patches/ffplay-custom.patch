+    { "Gray", 150, 150, 150 }
+};
+#define UI_NCOLORS 7
+static const av_unused int ui_seek_steps[] = { 1, 2, 3, 5, 10, 15, 30 };
+static const int ui_vol_steps[] = { 1, 2, 4, 8, 16 };
+static const int ui_hide_steps[] = { 1, 2, 3, 4, 5, 8, 10, 15, 30 };
