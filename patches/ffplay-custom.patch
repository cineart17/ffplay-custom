+        /* the dot to drag by: the bar color for the playing item and the one being dragged */
+        dot.w = 10;
+        dot.h = 10;
+        dot.x = right - 30;
+        dot.y = cy - 5;
+        if (item == q_pos || item == ui_q_drag)
