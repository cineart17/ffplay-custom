+static UiPkEnt *ui_pk_ent(int row)
+{
+    UiPkRow *w;
+
+    if (row < 0 || row >= ui_pk_nrw)
+        return NULL;
+    w = &ui_pk_rw[row];
+    if (w->kind == 0 && w->idx >= 0 && w->idx < ui_pk_n)
+        return &ui_pk_e[w->idx];
+    if (w->kind == 1 && w->idx >= 0 && w->idx < ui_pk_nx)
+        return &ui_pk_x[w->idx];
+    return NULL;
+}
