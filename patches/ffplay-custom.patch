+static void ui_text(int x, int y, const char *s)
+{
+    for (; *s; s++, x += 8) {
+        const uint8_t *g = avpriv_vga16_font + (uint8_t)*s * 16;
+        for (int row = 0; row < 16; row++)
+            for (int col = 0; col < 8; col++)
+                if (g[row] & (0x80 >> col))
+                    SDL_RenderDrawPoint(renderer, x + col, y + row);
