+                if (now - ui_flow_edge_at > gap) {
+                    ui_flow_target = av_clip(ui_flow_target + (ui_flow_mx < W / 2 ? -1 : 1) * (depth > 0.9 ? 2 : 1),
+                                             0, q_count - 1);
