+/* Draw the menu (and the logo on the idle screen). Does nothing if neither is showing. */
+static void toggle_pause(VideoState *is);
+
+/* ----- the queue panel: opens beside the "Queue" row ----- */
+#define UI_Q_W 420              /* panel width */
