+    } else if (sscanf(line, "vol %lf", &f) == 1) {
+        if (is) {
+            is->audio_volume = av_clip((int)(f * SDL_MIX_MAXVOLUME + 0.5), 0, SDL_MIX_MAXVOLUME);
