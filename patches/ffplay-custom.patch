+/* Read the settings file. If there is none yet, write one with the defaults. */
+static void settings_load(void)
+{
+    char path[1024], line[256];
+    const char *home = getenv("HOME");
+    char *p;
+    FILE *f;
+    double d;
+    int n, r, g, b;
+
+    if (!home)
+        return;
+    /* Make sure the folders exist (does nothing if they already do) */
+    snprintf(path, sizeof(path), "%s/.config", home);
+    mkdir(path, 0755);
+    snprintf(path, sizeof(path), "%s/.config/ffplay-custom", home);
+    mkdir(path, 0755);
+    snprintf(path, sizeof(path), "%s/.config/ffplay-custom/settings.conf", home);
+
+    f = fopen(path, "r");
+    if (!f) {
+        /* No file yet: write the defaults */
+        f = fopen(path, "w");
+        if (f) {
+            fputs(settings_default_text, f);
+            fclose(f);
+        }
+        return;
+    }
+
+    while (fgets(line, sizeof(line), f)) {
+        /* Let colors be written with commas too */
+        for (p = line; *p; p++)
+            if (*p == ',')
+                *p = ' ';
+
+        if (sscanf(line, " seek_seconds = %lf", &d) == 1)
+            (void)d;                    /* v39: the seek step is ffplay's own now; an old line is ignored */
+        else if (sscanf(line, " volume_step = %d", &n) == 1)
+            cfg_vol_step = av_clip(n, 1, 32);
+        else if (sscanf(line, " hide_seconds = %lf", &d) == 1)
+            cfg_hide_delay = (int64_t)(av_clipd(d, 0.5, 3600.0) * 1000000);
+        else if (sscanf(line, " fullscreen = %d", &n) == 1)
+            cfg_fullscreen = (n != 0);
+        else if (sscanf(line, " exact_seek = %d", &n) == 1)
+            cfg_exact_seek = (n != 0);
+        else if (sscanf(line, " picker = %d", &n) == 1)
+            cfg_picker = (n != 0);
+        else if (sscanf(line, " picker_grid = %d", &n) == 1)
+            cfg_pk_grid = (n != 0);
+        else if (sscanf(line, " picker_sort = %d", &n) == 1)
+            cfg_pk_sort = av_clip(n, 0, 2);
+        else if (sscanf(line, " picker_desc = %d", &n) == 1)
+            cfg_pk_desc = (n != 0);
+        else if (sscanf(line, " picker_thumbs = %d", &n) == 1)
+            cfg_pk_thumbs = (n != 0);
+        else if (sscanf(line, " crisp_text = %d", &n) == 1)
+            cfg_crisp = (n != 0);
+        else if (sscanf(line, " glass_tint = %d", &n) == 1)
+            cfg_tint = av_clip(n, 0, 100);
+        else if (sscanf(line, " roundness = %d", &n) == 1)
+            cfg_round = av_clip(n, 0, 100);
+        else if (sscanf(line, " bar_color = %d %d %d", &r, &g, &b) == 3) {
+            cfg_bar_r = av_clip(r, 0, 255);
+            cfg_bar_g = av_clip(g, 0, 255);
+            cfg_bar_b = av_clip(b, 0, 255);
+        } else if (sscanf(line, " remember_volume = %d", &n) == 1)
+            cfg_remember_volume = (n != 0);
+        else if (sscanf(line, " quit_when_done = %d", &n) == 1)
+            cfg_quit_when_done = (n != 0);
+        else if (sscanf(line, " scroll_action = %d", &n) == 1)
+            cfg_wheel = av_clip(n, 0, 2);
+        else if (sscanf(line, " crossfade = %d", &n) == 1)
+            cfg_crossfade = av_clip(n, 0, 10);
+        else if (sscanf(line, " music_folder = %399[^\n]", cfg_music_dir) == 1) {
+            n = (int)strlen(cfg_music_dir);
+            while (n > 0 && cfg_music_dir[n - 1] == ' ')
+                cfg_music_dir[--n] = 0;
+        } else if (sscanf(line, " video_folder = %399[^\n]", cfg_video_dir) == 1) {
+            n = (int)strlen(cfg_video_dir);
+            while (n > 0 && cfg_video_dir[n - 1] == ' ')
+                cfg_video_dir[--n] = 0;
+        } else if (sscanf(line, " font = %400[^\n]", cfg_font) == 1) {
+            n = (int)strlen(cfg_font);
+            while (n > 0 && cfg_font[n - 1] == ' ')
+                cfg_font[--n] = 0;
+        }
+    }
+    fclose(f);
+
+    is_full_screen = 0;                         /* v40: never the borderless full screen at the start: it is one double tap away */
+    ui_start_max = cfg_fullscreen;              /* On = the conventional full screen, Off = a normal window */
+}
