+/* The choices of a row, for the list that shows when the mouse is on it. Returns how many; sel = the one that is on (or -1) */
+static const double ui_seek_choices[] = { 0.3, 0.5, 1, 2, 3, 5, 10, 15, 30 };
+
+static int ui_pref_choices(int row, const char *names[10], char store[10][20], int *sel)
+{
+    int n = 0, i, b = 0;
+
+    *sel = -1;
+    if (ui_pref_slider(row))
+        return 0;                               /* v46: a slider has no list */
+    row++;
+    switch (row) {
+    case 0:
+        for (i = 0; i < 9; i++) {
+            snprintf(store[i], 20, "%gs", ui_seek_choices[i]);
+            if (fabs(ui_seek_choices[i] - cfg_seek) < fabs(ui_seek_choices[b] - cfg_seek))
+                b = i;
+        }
+        n = 9;
+        *sel = b;
+        break;
+    case 1:
+        for (i = 0; i < 5; i++) {
+            snprintf(store[i], 20, "%d", ui_vol_steps[i]);
+            if (FFABS(ui_vol_steps[i] - cfg_vol_step) < FFABS(ui_vol_steps[b] - cfg_vol_step))
+                b = i;
+        }
+        n = 5;
+        *sel = b;
+        break;
+    case 2:
+        for (i = 0; i < 9; i++) {
+            snprintf(store[i], 20, "%ds", ui_hide_steps[i]);
+            if (fabs(ui_hide_steps[i] - cfg_hide_delay / 1000000.0) < fabs(ui_hide_steps[b] - cfg_hide_delay / 1000000.0))
+                b = i;
+        }
+        n = 9;
+        *sel = b;
+        break;
+    case 4:
+        for (i = 0; i < UI_NCOLORS; i++)
+            snprintf(store[i], 20, "%s", ui_colors[i].name);
+        n = UI_NCOLORS;
+        *sel = ui_color_index();
+        break;
+    case 7:
+        snprintf(store[0], 20, "Seek");
+        snprintf(store[1], 20, "Volume");
+        snprintf(store[2], 20, "Navigation");
+        n = 3;
+        *sel = av_clip(cfg_wheel, 0, 2);
+        break;
+    default:                                    /* the switches: Off and On */
+        snprintf(store[0], 20, "Off");
+        snprintf(store[1], 20, "On");
+        n = 2;
+        *sel = (row == 3 ? cfg_fullscreen : row == 5 ? cfg_remember_volume : cfg_quit_when_done) ? 1 : 0;
+        break;
+    }
+    for (i = 0; i < n; i++)
+        names[i] = store[i];
+    return n;
+}
+
+/* Where the choices of a row go: on the right of the name, which stays. The text and the gaps get smaller if they would not
+   fit in the room that is left. Returns how many. */
+static int ui_pl_title_x = 0;           /* where the name starts when the choices are showing */
+
+/* The name and the choices of a row are one row of items: the name first, then the choices, the same padding on each and
+   the same gap between them, the whole row in the middle of the panel. */
+static int ui_pref_layout(int row, const SDL_Rect *p, int cy, SDL_Rect out[10], const char *names[10], char store[10][20],
+                          int *sel, int *px)
+{
+    static const int px_try[4] = { 18, 16, 15, 14 }, pad_try[4] = { 18, 14, 10, 8 }, gap_try[4] = { 6, 5, 4, 3 };
+    int n = ui_pref_choices(row, names, store, sel), i, total = 0, x, w[10], pass, room, gap = 3;
+
+    room = p->w - 2 * ui_pr_mg - ui_text_width(ui_pref_name[row], ui_pr_px) - 26 - UI_PREF_ICW;      /* the icon and the name stay at their margin (nudged 10 px) */
+    *px = 14;
+    for (pass = 0; pass < 4; pass++) {
+        gap = gap_try[pass];
+        total = 0;
+        for (i = 0; i < n; i++) {
+            w[i] = ui_text_width(names[i], px_try[pass]) + pad_try[pass];
+            total += w[i] + (i ? gap : 0);
+        }
+        *px = px_try[pass];
+        if (total <= room)
+            break;
+    }
+    x = p->x + p->w - ui_pr_mg - total;         /* against the right margin */
+    ui_pl_title_x = p->x + ui_pr_mg + 10;
+    for (i = 0; i < n; i++) {
+        out[i].x = x;
+        out[i].y = cy - FFMIN(32, ui_pr_row - 6) / 2;
+        out[i].w = w[i];
+        out[i].h = FFMIN(32, ui_pr_row - 6);
+        x += w[i] + gap;
+    }
+    return n;
+}
+
+/* The width the panel needs so that the name and all choices of a row fit, at the smallest text */
+static int ui_pref_need_w(int row)
+{
+    const char *names[10];
+    char store[10][20];
+    int sel, n = ui_pref_choices(row, names, store, &sel), i, total = 0;
+
+    for (i = 0; i < n; i++)
+        total += ui_text_width(names[i], 14) + 8 + 3;
+    return 2 * ui_pr_mg + ui_text_width(ui_pref_name[row], ui_pr_px) + 26 + UI_PREF_ICW + total;
+}
+
+/* Which choice of the row is at x, y? -1 if none (or if the choices are not showing yet) */
+static int ui_pref_chip_at(int row, const SDL_Rect *p, int x, int y)
+{
+    SDL_Rect r[10];
+    const char *names[10];
+    char store[10][20];
+    int n, i, sel, px, cy = p->y + UI_PREF_HEAD + ui_pref_pos(row) * UI_PREF_ROW + UI_PREF_ROW / 2;
+
+    if (row < 0 || row >= UI_PREF_ROWS || ui_pref_slider(row) || ui_pref_pos(row) < 0)
+        return -1;
+    n = ui_pref_layout(row, p, cy, r, names, store, &sel, &px);
+    for (i = 0; i < n; i++)
+        if (x >= r[i].x && x < r[i].x + r[i].w && y >= r[i].y && y < r[i].y + r[i].h)
+            return i;
+    return -1;
+}
+
+/* Pick choice number idx of a row and save the file */
+static void ui_pref_choose(int row, int idx)
+{
+    row++;
+    switch (row) {
+    case 0: cfg_seek = ui_seek_choices[av_clip(idx, 0, 8)]; break;
+    case 1: cfg_vol_step = ui_vol_steps[av_clip(idx, 0, 4)]; break;
+    case 2: cfg_hide_delay = (int64_t)ui_hide_steps[av_clip(idx, 0, 8)] * 1000000; break;
+    case 3: cfg_fullscreen = idx != 0; break;
+    case 4:
+        idx = av_clip(idx, 0, UI_NCOLORS - 1);
+        cfg_bar_r = ui_colors[idx].r;
+        cfg_bar_g = ui_colors[idx].g;
+        cfg_bar_b = ui_colors[idx].b;
+        break;
+    case 5: cfg_remember_volume = idx != 0; break;
+    case 6: cfg_quit_when_done = idx != 0; break;
+    default: cfg_wheel = av_clip(idx, 0, 2); break;
+    }
+    settings_save();
+}
+
+/* Change a setting (dir = -1 or 1 for the arrows) and save the file */
+static av_unused void ui_pref_change(int row, int dir)
+{
+    int i;
+
+    row++;
+    switch (row) {
+    case 0: {
+        static const double st[] = { 0.3, 0.5, 1, 2, 3, 5, 10, 15, 30 };
+        int b = 0, k;
+
+        for (k = 1; k < 9; k++)
+            if (fabs(st[k] - cfg_seek) < fabs(st[b] - cfg_seek))
+                b = k;
+        cfg_seek = st[av_clip(b + dir, 0, 8)];
+        break;
+    }
+    case 1: cfg_vol_step = ui_step_list(ui_vol_steps, 5, cfg_vol_step, dir); break;
+    case 2:
+        cfg_hide_delay = (int64_t)ui_step_list(ui_hide_steps, 9, cfg_hide_delay / 1000000.0, dir) * 1000000;
+        break;
+    case 3: cfg_fullscreen = !cfg_fullscreen; break;
+    case 4:
+        i = (ui_color_index() + dir + UI_NCOLORS) % UI_NCOLORS;
+        cfg_bar_r = ui_colors[i].r;
+        cfg_bar_g = ui_colors[i].g;
+        cfg_bar_b = ui_colors[i].b;
+        break;
+    case 5: cfg_remember_volume = !cfg_remember_volume; break;
+    case 6: cfg_quit_when_done = !cfg_quit_when_done; break;
+    default: cfg_wheel = (cfg_wheel + dir + 3) % 3; break;
+    }
+    settings_save();
+}
+
+/* ----- v46: the sliders. Each has a range, what it shows, and how it is put into the setting ----- */
+static int ui_pref_drag = -1;           /* the slider that is being dragged (-1 = none) */
+
+static double ui_sl_lo(int r)
+{
+    return r == 1 ? 0.5 : r == 0 ? 1.0 : 0.0;
+}
+
+static double ui_sl_hi(int r)
+{
+    return r == 0 ? 16.0 : r == 1 ? 30.0 : r == 7 ? 10.0 : r == 8 ? 120.0 : 100.0;
+}
+
+static double ui_sl_get(int r)
+{
+    switch (r) {
+    case 0: return cfg_vol_step;
+    case 1: return cfg_hide_delay / 1000000.0;
+    case 7: return cfg_crossfade;
+    case 8: return q_sleep_end ? ceil((q_sleep_end - av_gettime_relative()) / 60000000.0) : 0.0;     /* the minutes left of the timer that runs */
+    case 9: return cfg_tint;
+    default: return cfg_round;
+    }
+}
+
+static void ui_sl_put(int r, double v)
+{
+    v = av_clipd(v, ui_sl_lo(r), ui_sl_hi(r));
+    switch (r) {
+    case 0: cfg_vol_step = (int)(v + 0.5); break;
+    case 1:
+        v = v < 3.0 ? floor(v * 10.0 + 0.5) / 10.0 : v < 10.0 ? floor(v * 2.0 + 0.5) / 2.0 : floor(v + 0.5);
+        cfg_hide_delay = (int64_t)(v * 1000000.0);
+        break;
+    case 7: cfg_crossfade = (int)(v + 0.5); break;
+    case 8: ui_sleep_set_minutes((int)(v + 0.5)); break;
+    case 9: cfg_tint = (int)(v + 0.5); break;
+    default: cfg_round = (int)(v + 0.5); break;
+    }
+}
+
+static double ui_sl_t(int r)
+{
+    double v = av_clipd(ui_sl_get(r), ui_sl_lo(r), ui_sl_hi(r)), lo = ui_sl_lo(r), hi = ui_sl_hi(r);
+
+    return r == 1 ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);      /* the hiding time is finer at the short end */
+}
+
+static void ui_sl_text(int r, char *out, size_t size)
+{
+    switch (r) {
+    case 0: snprintf(out, size, "%d", cfg_vol_step); break;
+    case 1: snprintf(out, size, "%g s", cfg_hide_delay / 1000000.0); break;
+    case 7:
+        if (cfg_crossfade)
+            snprintf(out, size, "%d s", cfg_crossfade);
+        else
+            snprintf(out, size, "Off");
+        break;
+    case 8:
+        if (q_sleep_end)
+            snprintf(out, size, "%d min", (int)ui_sl_get(8));
+        else
+            snprintf(out, size, q_sleep_item ? "Track end" : "Off");
+        break;
+    case 9: snprintf(out, size, "%d%%", cfg_tint); break;
+    default:
+        if (cfg_round)
+            snprintf(out, size, "%d%%", cfg_round);
+        else
+            snprintf(out, size, "Square");
+        break;
+    }
+}
+
+/* One step of the arrow keys and of a notch of the wheel */
+static void ui_sl_nudge(int r, int dir)
+{
+    double v = ui_sl_get(r), st;
+
+    st = r == 1 ? (v < 3.0 - 0.01 || (dir < 0 && v <= 3.0 + 0.01) ? 0.1 : v < 10.0 - 0.01 || (dir < 0 && v <= 10.0 + 0.01) ? 0.5 : 1.0) :
+         r == 8 ? 5.0 : r >= 9 ? 5.0 : 1.0;
+    if (r == 8 && dir < 0 && v <= 5.0)
+        v = 5.0;                                /* down from 5 minutes: off */
+    ui_sl_put(r, v + dir * st);
+    settings_save();
+}
+
+/* Where the slider of a row is: the track from x0 to x1, the value after it. The same column for every row. */
+static void ui_sl_geom(const SDL_Rect *p, int *x0, int *x1, int *xr)
+{
+    int vw = ui_text_width("120 min", ui_pr_px) + 6;
+
+    *xr = p->x + p->w - ui_pr_mg;
+    *x0 = p->x + ui_pr_mg + UI_PREF_ICW + ui_text_width("Hide bars after", ui_pr_px) + 30;
+    *x1 = *xr - vw - 18;
+    if (*x1 - *x0 < 70)
+        *x0 = *x1 - 70;
+}
+
+static int ui_sl_hit(const SDL_Rect *p, int r, int x)
+{
+    int x0, x1, xr;
+
+    ui_sl_geom(p, &x0, &x1, &xr);
+    return x >= x0 - 12 && x <= x1 + 12;
+}
+
+static void ui_sl_drag_to(const SDL_Rect *p, int r, int x)
+{
+    int x0, x1, xr;
+    double t, lo = ui_sl_lo(r), hi = ui_sl_hi(r);
+
+    ui_sl_geom(p, &x0, &x1, &xr);
+    t = av_clipd((double)(x - x0) / FFMAX(x1 - x0, 1), 0.0, 1.0);
+    ui_sl_put(r, r == 1 ? lo * pow(hi / lo, t) : lo + (hi - lo) * t);
+}
+
+static void ui_sl_draw(const SDL_Rect *p, int r, int cy)
+{
+    SDL_Rect tr, fill;
+    char text[32];
+    int x0, x1, xr, hot = r == ui_prefs_hover || r == ui_pref_drag;
+    double t = av_clipd(ui_sl_t(r), 0.0, 1.0);
+
+    ui_sl_geom(p, &x0, &x1, &xr);
+    tr.x = x0;
+    tr.h = hot ? 8 : 6;                         /* v47: no knob: the track thickens a little under the mouse */
+    tr.y = cy - tr.h / 2;
+    tr.w = x1 - x0;
+    SDL_SetRenderDrawColor(renderer, 255, 255, 255, 45);
+    ui_pill(&tr);                               /* the track, as on the seek bar */
+    fill = tr;
+    fill.w = t > 0.0 ? FFMAX((int)(tr.w * t), tr.h) : 0;       /* v47: no stub at the start (the knob used to hide it) */
+    SDL_SetRenderDrawColor(renderer, av_clip(cfg_bar_r + 60, 0, 255), av_clip(cfg_bar_g + 60, 0, 255), av_clip(cfg_bar_b + 60, 0, 255),
+                           hot ? 235 : 200);
+    if (fill.w > 0)
+        ui_pill(&fill);                         /* the part before the value: a lighter shade of the bar color */
+    ui_sl_text(r, text, sizeof(text));
+    ui_label(xr - ui_text_width(text, ui_pr_px), cy, text, ui_pr_px, hot ? 255 : 225, hot ? 255 : 225, hot ? 255 : 225, 255);
+    if (r == 8 && q_sleep_end)
+        ui_prefs_anim = 1;                      /* the timer runs: the knob follows it */
+}
+
+static SDL_Rect ui_prefs_rect(int ww, int wh)
+{
+    SDL_Rect p;
+    int avail = wh - 16;
+
+    if (avail >= 76 + UI_PREF_SHOWN * 52 + 52) {         /* room enough: the full size */
+        ui_pr_head = 76;
+        ui_pr_row = 52;
+        ui_pr_foot = 52;
+        ui_pr_px = 20;
+        ui_pr_tpx = 28;
+    } else if (avail >= 40 + UI_PREF_SHOWN * 34) {       /* a shorter window: smaller rows, no hint */
+        ui_pr_head = 40;
+        ui_pr_foot = 0;
+        ui_pr_row = av_clip((avail - 40) / UI_PREF_SHOWN, 34, 52);
+        ui_pr_px = ui_pr_row >= 40 ? 20 : 17;
+        ui_pr_tpx = 22;
+    } else {                                            /* a very small window */
+        ui_pr_head = 30;
+        ui_pr_foot = 0;
+        ui_pr_row = FFMAX((avail - 30) / UI_PREF_SHOWN, 22);
+        ui_pr_px = 14;
+        ui_pr_tpx = 18;
+    }
+    ui_pr_mg = ww < 560 ? 14 : 32;
+    p.w = FFMIN((int)(ui_prefs_w + 0.5), ww - 16);
+    p.h = UI_PREF_HEAD + UI_PREF_SHOWN * UI_PREF_ROW + UI_PREF_FOOT;
+    p.x = (ww - p.w) / 2;
+    p.y = FFMAX((wh - p.h) / 2, 4);
+    return p;
+}
+
+static void ui_prefs_draw(void)
+{
+    SDL_Rect p;
+    int ww, wh, i, cy;
+    double dt, wt;
+    static int64_t last = 0;
+    int64_t now = av_gettime_relative();
+
+    if (!ui_prefs_open) {
+        for (i = 0; i < UI_PREF_ROWS; i++) {
+            ui_pref_open[i] = 0.0;
+            ui_pref_hv[i] = 0.0;
+        }
+        memset(ui_pref_pop, 0, sizeof(ui_pref_pop));
+        ui_prefs_anim = 0;
+        ui_prefs_w = 600.0;
+        return;
+    }
+    dt = now - last > 100000 ? 0.016 : (now - last) / 1000000.0;
+    last = now;
+    ui_prefs_anim = 0;
+    for (i = 0; i < UI_PREF_ROWS; i++) {
+        double tgt = i == ui_prefs_hover ? 1.0 : 0.0;
+
+        ui_pref_open[i] = ui_pref_slider(i) ? 0.0 : 1.0;        /* v47: no cascade: the choices of a row are always showing */
+        ui_pref_hv[i] += (tgt - ui_pref_hv[i]) * (1.0 - exp(-dt / 0.07));     /* the title of the row under the mouse nudges */
+        if (fabs(tgt - ui_pref_hv[i]) < 0.005)
+            ui_pref_hv[i] = tgt;
+        else
+            ui_prefs_anim = 1;
+    }
+    SDL_GetWindowSize(window, &ww, &wh);
+    wt = 600.0;                                 /* wide enough for the name and all the choices of the longest row */
+    for (i = 0; i < UI_PREF_ROWS; i++)
+        if (ui_pref_pos(i) >= 0 && !ui_pref_slider(i))
+            wt = FFMAX(wt, ui_pref_need_w(i));
+    ui_prefs_w = FFMIN(wt, ww - 16);
+    p = ui_prefs_rect(ww, wh);
+    ui_glass(&p, 28);
+
+    SDL_SetRenderDrawBlendMode(renderer, SDL_BLENDMODE_BLEND);
+    ui_label(p.x + ui_pr_mg, p.y + UI_PREF_HEAD / 2 + 4, "Preferences", ui_pr_tpx, 245, 245, 245, 255);
+    for (i = 0; i < UI_PREF_ROWS; i++) {
+        static const int pic[UI_PREF_ROWS] = { UI_IC_VOLUME, UI_IC_EYE, UI_IC_EXPAND, UI_IC_DROP,
+                                               UI_IC_BOOKMARK, UI_IC_EXIT, UI_IC_MOUSE, UI_IC_FADE, UI_IC_MOON,
+                                               UI_IC_DROP, UI_IC_EXPAND };
+        double hv = ui_pref_hv[i];
+        int nudge;
+
+        if (ui_pref_pos(i) < 0)
+            continue;                           /* Crossfade and Sleep timer are in the queue menu */
+        cy = p.y + UI_PREF_HEAD + ui_pref_pos(i) * UI_PREF_ROW + UI_PREF_ROW / 2;
+        hv = hv * hv * (3.0 - 2.0 * hv);
+        nudge = (int)(UI_PREF_NUDGE * hv + 0.5);        /* the icon and the name move a little from the left margin */
+        ui_icon(pic[i], p.x + ui_pr_mg + nudge, cy, av_clip(ui_pr_px, 14, 22), 245, 245, 245, i == ui_prefs_hover ? 255 : 170);
+        ui_label(p.x + ui_pr_mg + UI_PREF_ICW + nudge, cy, ui_pref_name[i], ui_pr_px, 245, 245, 245,
+                 i == ui_prefs_hover ? 255 : 210);
+        if (ui_pref_slider(i)) {                /* v46 */
+            ui_sl_draw(&p, i, cy);
+            continue;
+        }
+        {                                       /* the choices: all showing; the one under the mouse grows from its centre */
+            SDL_Rect r[10];
+            const char *names[10];
+            char store[10][20];
+            int n, c, sel, px, hot;
+
+            n = ui_pref_layout(i, &p, cy, r, names, store, &sel, &px);
+            for (c = 0; c < n; c++) {
+                int mv = 0, cx = r[c].x + r[c].w / 2;
+                double pe, sc;
+
+                hot = i == ui_prefs_hover && ui_prefs_mx >= r[c].x && ui_prefs_mx < r[c].x + r[c].w &&
+                      ui_prefs_my >= r[c].y && ui_prefs_my < r[c].y + r[c].h;
+                pe = ui_pop_step(&ui_pref_pop[i][c], hot, dt, &mv);
+                if (mv)
+                    ui_prefs_anim = 1;
+                sc = 1.0 + 0.15 * pe + 0.10 * sin(pe * 3.14159265);     /* a little too big on the way, then it settles */
+                if (c == sel)                   /* the choice that is on: in the bar color */
+                    ui_label_cs(cx, cy, names[c], px, av_clip(cfg_bar_r + 40 + (int)(30 * pe), 0, 255),
+                                av_clip(cfg_bar_g + 40 + (int)(30 * pe), 0, 255), av_clip(cfg_bar_b + 40 + (int)(30 * pe), 0, 255),
+                                255, sc);
+                else
+                    ui_label_cs(cx, cy, names[c], px, 215 + (int)(40 * pe), 215 + (int)(40 * pe), 215 + (int)(40 * pe),
+                                (int)(165 + 90 * pe), sc);
+            }
+        }
+    }
+    if (UI_PREF_FOOT >= 30)
+        ui_label(p.x + ui_pr_mg, p.y + p.h - UI_PREF_FOOT / 2, "Click a choice. Sliders: drag, scroll or arrows. Esc closes.",
+             15, 170, 170, 170, 255);
+}
