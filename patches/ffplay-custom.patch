+
+/* The mouse moved with a cover held down. Returns 1 while a cover is held. */
+static int ui_flow_motion(VideoState *is, int x, int y)
+{
+    if (ui_flow_press < 0)
+        return 0;
+    if (!ui_flow_dragging && (FFABS(x - ui_flow_px) >= 8 || FFABS(y - ui_flow_py) >= 8)) {
+        ui_flow_dragging = 1;
+        ui_flow_drop = -1;
