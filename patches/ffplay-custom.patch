+                char t1[32], t2[32];
+                int e1 = (int)FFMAX(wpos, 0.0), e2 = (int)FFMAX(wdur - wpos, 0.0);
+
+                if (e1 >= 3600)
+                    snprintf(t1, sizeof(t1), "%d:%02d:%02d", e1 / 3600, e1 / 60 % 60, e1 % 60);
+                else
+                    snprintf(t1, sizeof(t1), "%d:%02d", e1 / 60, e1 % 60);
+                if (e2 >= 3600)
+                    snprintf(t2, sizeof(t2), "%d:%02d:%02d", e2 / 3600, e2 / 60 % 60, e2 % 60);
