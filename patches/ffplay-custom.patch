+    ui_q_line(ex + 65, cy + 5, ex + 79, cy + 5);
+    ui_q_line(ex + 64, cy - 4, ex + 64, cy + 4);
+    ui_q_line(ex + 80, cy - 4, ex + 80, cy + 4);
+    ui_tri(ex + 74, cy - 5, 7, 8, 1);
