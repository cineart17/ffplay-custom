+
+/* A round button with an icon in the top bar */
+static void ui_pk_ibtn(const SDL_Rect *r, int icon, int hot, int on, int alpha)
+{
+    SDL_SetRenderDrawBlendMode(renderer, SDL_BLENDMODE_BLEND);
