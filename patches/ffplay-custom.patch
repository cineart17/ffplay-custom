+/* v46: the rows are numbered as they were (and the four new ones 7 to 10); this is the order they are shown in, top to bottom */
+static const int ui_pref_map[UI_PREF_SHOWN] = { 0, 1, 2, 3, 4, 5, 6, 9, 10 };
