+
+    ui_ctx_open = 0;
+    ui_ctx_name = NULL;
+    ui_ctx_hover = -1;
+    for (i = 0; i < q_count; i++)
+        if (q_items[i] == name)
+            idx = i;
+    if (idx < 0)
+        return;
+    if (act == 0) {
+        was_playing = (idx == q_pos);
+        queue_remove(idx);
+        ui_q_hover_kind = UI_Q_NONE;
+        ui_q_hover_idx = -1;
+        if (was_playing)
+            ui_end_current(is);     /* the next item takes its place */
+    } else {
+        q_sleep_end = 0;
+        ui_sleep_gain = 1.0f;
+        q_sleep_item = (q_sleep_item == q_items[idx]) ? NULL : q_items[idx];
+        ui_sleep_sel = q_sleep_item ? 1 : 0;
+    }
+}
