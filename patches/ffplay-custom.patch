+            *(void **)&x_atom = dlsym(xlib, "XInternAtom");
+            *(void **)&x_root = dlsym(xlib, "XDefaultRootWindow");
+            *(void **)&x_send = dlsym(xlib, "XSendEvent");
+            *(void **)&x_flush = dlsym(xlib, "XFlush");
+        }
+    }
+    if (!x_atom || !x_root || !x_send || !x_flush)
+        return;
+    memset(&ev, 0, sizeof(ev));
+    ev.m.type = 33;                             /* ClientMessage */
+    ev.m.display = info.info.x11.display;
+    ev.m.window = info.info.x11.window;
+    ev.m.message_type = x_atom(info.info.x11.display, "_NET_WM_STATE", 0);
+    ev.m.format = 32;
+    ev.m.l[0] = add ? 1 : 0;                    /* _NET_WM_STATE_ADD / _NET_WM_STATE_REMOVE */
+    ev.m.l[1] = (long)x_atom(info.info.x11.display, name, 0);
+    ev.m.l[3] = 1;                              /* the source: a normal application */
+    x_send(info.info.x11.display, x_root(info.info.x11.display), 0, (1L << 20) | (1L << 19), &ev);
+    x_flush(info.info.x11.display);
+}
+
+/* v41: the miniplayer follows the mouse while the picture is pressed and moved (the window manager's own move is only for the
+   title bar). pd_on: a press is waiting; pd_moved: it has become a drag. */
+static int ui_pd_on = 0, ui_pd_moved = 0, ui_pd_gx, ui_pd_gy, ui_pd_wx, ui_pd_wy;
+static int64_t ui_last_lclick = 0;              /* time of the last left click in the picture (a second one within half a second = double tap) */
+
+/* ----- picture in picture: the window as a small miniplayer on top, in a corner ----- */
+static int ui_pip = 0, ui_pip_was_top = 0, ui_pip_was_max = 0;     /* (was_top, was_max: how the window was before the miniplayer) */
+static int ui_pip_x, ui_pip_y, ui_pip_w, ui_pip_h, ui_pip_user, ui_pip_kw, ui_pip_kh;     /* the window as it was */
+
+/* Where the miniplayer was left (x, y and width) is kept in ~/.config/ffplay-custom/miniplayer.conf */
+static void ui_pip_conf(char *out, size_t size)
+{
+    const char *home = getenv("HOME");
+
+    snprintf(out, size, "%s/.config/ffplay-custom/miniplayer.conf", home ? home : "");
+}
+
+static void ui_pip_save(void)
+{
+    char path[1024];
+    int x, y, w, h;
+    FILE *f;
+
+    if (!ui_pip || !window || ui_grow_on)
+        return;
+    SDL_GetWindowPosition(window, &x, &y);
+    SDL_GetWindowSize(window, &w, &h);
+    if (w < 200 || h < 100)
+        return;
+    ui_pip_conf(path, sizeof(path));
+    f = fopen(path, "w");
+    if (!f)
+        return;
+    fprintf(f, "%d %d %d\n", x, y, w);
+    fclose(f);
+}
+
+static int ui_pip_load(int *x, int *y, int *w)
+{
+    char path[1024];
+    FILE *f;
+    int n;
+
+    ui_pip_conf(path, sizeof(path));
+    f = fopen(path, "r");
+    if (!f)
+        return 0;
+    n = fscanf(f, "%d %d %d", x, y, w);
+    fclose(f);
+    return n == 3;
+}
+
+/* The miniplayer grows out of its place into the screen (eased, a few tens of steps), then the window goes full screen, which at
+   that size changes nothing you can see. Its always on top and show on all workspaces are switched off. 1 = handled. */
+#define UI_GROW_US 280000
+static int ui_grow_x0, ui_grow_y0, ui_grow_w0, ui_grow_h0, ui_grow_x1, ui_grow_y1, ui_grow_w1, ui_grow_h1;
+static int64_t ui_grow_t0 = 0, ui_grow_last = 0;
+static int ui_pg_return = 0;                    /* 1 = full screen came from the miniplayer: leaving it goes back to the window before it */
+static int64_t ui_pg_restore_at = 0;
+
+static void ui_pip_left_fs(void)
+{
+    if (ui_pg_return) {
+        ui_pg_return = 0;
+        ui_pg_restore_at = av_gettime_relative() + 150000;      /* after the window manager has put its own size back */
+    }
+}
+
+static int ui_pip_grow(VideoState *is)
+{
+    SDL_Rect db;
+    int di;
+
+    if (!ui_pip || !window || is_full_screen || ui_grow_on)
+        return 0;
+    di = SDL_GetWindowDisplayIndex(window);
+    if (di < 0)
+        di = 0;
+    if (SDL_GetDisplayBounds(di, &db) != 0)
+        return 0;                               /* no screen size: the plain way (the caller does it) */
+    ui_pip_save();
+    SDL_GetWindowPosition(window, &ui_grow_x0, &ui_grow_y0);
+    SDL_GetWindowSize(window, &ui_grow_w0, &ui_grow_h0);
+    ui_grow_x1 = db.x;
+    ui_grow_y1 = db.y;
+    ui_grow_w1 = db.w;
+    ui_grow_h1 = db.h;
+    ui_pip = 0;                                 /* it is no miniplayer any more: what the miniplayer switched on goes off */
+    ui_on_top = ui_pip_was_top;
+    SDL_SetWindowAlwaysOnTop(window, ui_pip_was_top ? SDL_TRUE : SDL_FALSE);
+    ui_wm_state("_NET_WM_STATE_STICKY", 0);
+    ui_user_sized = ui_pip_user;
+    ui_keep_w = ui_pip_kw;
+    ui_keep_h = ui_pip_kh;
+    ui_grow_on = 1;
+    ui_grow_t0 = av_gettime_relative();
+    ui_grow_last = 0;
+    ui_fs_toggle_at = ui_grow_t0;
+    ui_prog_until = ui_grow_t0 + 2000000;
+    if (is)
+        is->force_refresh = 1;
+    return 1;
+}
+
+static void ui_grow_tick(VideoState *is)
+{
+    int64_t now;
+    double f, e;
+    int x, y, w, h;
+
+    now = av_gettime_relative();
+    if (ui_pg_restore_at && now >= ui_pg_restore_at && window) {    /* out of full screen: the window as it was before the miniplayer */
+        ui_pg_restore_at = 0;
+        if (!is_full_screen && !ui_maxed) {
+            SDL_SetWindowSize(window, ui_pip_w, ui_pip_h);
+            SDL_SetWindowPosition(window, ui_pip_x, ui_pip_y);
+            ui_prog_w = ui_pip_w;
+            ui_prog_h = ui_pip_h;
+            ui_fs_toggle_at = now;
+            ui_prog_until = now + 2000000;
+            if (is)
+                is->force_refresh = 1;
+        }
+    }
+    if (!ui_grow_on || !window)
+        return;
+    if (now - ui_grow_last < 7000)
+        return;                                 /* about 140 steps a second at most */
+    ui_grow_last = now;
+    f = (now - ui_grow_t0) / (double)UI_GROW_US;
+    if (f >= 1.0) {
+        SDL_SetWindowPosition(window, ui_grow_x1, ui_grow_y1);
+        SDL_SetWindowSize(window, ui_grow_w1, ui_grow_h1);
+        ui_grow_on = 0;
+        is_full_screen = 1;
+        ui_fs_toggle_at = now;
+        ui_prog_until = now + 2000000;
+        SDL_SetWindowFullscreen(window, SDL_WINDOW_FULLSCREEN_DESKTOP);
+        SDL_SetWindowSize(window, ui_pip_w, ui_pip_h);      /* where leaving full screen goes: the window as it was before the miniplayer */
+        SDL_SetWindowPosition(window, ui_pip_x, ui_pip_y);
+        ui_maxed = ui_pip_was_max;              /* a window that filled the screen fills it again */
+        ui_pg_return = 1;
+        if (is)
+            is->force_refresh = 1;
+        return;
+    }
+    e = f < 0.5 ? 4.0 * f * f * f : 1.0 - pow(-2.0 * f + 2.0, 3.0) / 2.0;      /* ease in and out */
+    x = ui_grow_x0 + (int)((ui_grow_x1 - ui_grow_x0) * e);
+    y = ui_grow_y0 + (int)((ui_grow_y1 - ui_grow_y0) * e);
+    w = ui_grow_w0 + (int)((ui_grow_w1 - ui_grow_w0) * e);
+    h = ui_grow_h0 + (int)((ui_grow_h1 - ui_grow_h0) * e);
+    ui_prog_w = w;
+    ui_prog_h = h;
+    ui_prog_until = now + 1500000;
+    SDL_SetWindowSize(window, w, h);
+    SDL_SetWindowPosition(window, x, y);
+    if (is)
+        is->force_refresh = 1;
+}
+
+static void ui_pip_end(void)
+{
+    if (!ui_pip || !window)
+        return;
+    ui_pip_save();                              /* v37: where it was left is where it opens next time */
+    ui_pip = 0;
+    ui_on_top = ui_pip_was_top;                 /* on top again only if it was before */
+    SDL_SetWindowAlwaysOnTop(window, ui_pip_was_top ? SDL_TRUE : SDL_FALSE);
+    ui_wm_state("_NET_WM_STATE_STICKY", 0);     /* and on this workspace only again */
+    ui_fs_toggle_at = av_gettime_relative();    /* the sizes that follow are ours, not the user's */
+    ui_prog_until = ui_fs_toggle_at + 2000000;
+    ui_prog_w = ui_pip_w;
+    ui_prog_h = ui_pip_h;
+    SDL_SetWindowSize(window, ui_pip_w, ui_pip_h);
+    SDL_SetWindowPosition(window, ui_pip_x, ui_pip_y);
+    ui_user_sized = ui_pip_user;
+    ui_keep_w = ui_pip_kw;
+    ui_keep_h = ui_pip_kh;
+    if (ui_pip_was_max)
+        ui_max_set(1);                          /* it was the conventional window that fills the screen: it fills it again */
+}
+
+static void ui_pip_toggle(VideoState *is)
+{
+    SDL_Rect ub;
+    int di, cw = 16, ch = 9, w, h, px, py;
+
+    if (!window)
+        return;
+    if (ui_pip) {
+        ui_pip_end();
+        if (is)
+            is->force_refresh = 1;
+        return;
+    }
+    if (is_full_screen) {                       /* leave full screen first, and wait (at most 0.4 s) for the window manager */
+        int64_t t0 = av_gettime_relative();
+
+        is_full_screen = 0;
+        SDL_SetWindowFullscreen(window, 0);
+        SDL_PumpEvents();
+        while (av_gettime_relative() - t0 < 400000 &&
+               (SDL_GetWindowFlags(window) & (SDL_WINDOW_FULLSCREEN | SDL_WINDOW_FULLSCREEN_DESKTOP))) {
+            SDL_Delay(10);
+            SDL_PumpEvents();
+        }
+    }
+    ui_pip_was_max = ui_maxed;
+    if (ui_maxed)
+        ui_max_set(0);
+    ui_fs_toggle_at = av_gettime_relative();
+    ui_prog_until = ui_fs_toggle_at + 2000000;
+    SDL_GetWindowPosition(window, &ui_pip_x, &ui_pip_y);
+    SDL_GetWindowSize(window, &ui_pip_w, &ui_pip_h);
+    ui_pip_user = ui_user_sized;
+    ui_pip_kw = ui_keep_w;
+    ui_pip_kh = ui_keep_h;
+    if (is && is->video_st && !(is->video_st->disposition & AV_DISPOSITION_ATTACHED_PIC) &&
+        is->video_st->codecpar->width > 0 && is->video_st->codecpar->height > 0) {
+        cw = is->video_st->codecpar->width;     /* the miniplayer has the video's shape */
+        ch = is->video_st->codecpar->height;
+    }
+    di = SDL_GetWindowDisplayIndex(window);
+    if (di < 0)
+        di = 0;
+    if (SDL_GetDisplayUsableBounds(di, &ub) != 0) {
+        ub.x = 0;
+        ub.y = 0;
+        ub.w = 1280;
+        ub.h = 720;
+    }
+    w = av_clip(ub.w / 4, 360, 640);
+    h = av_clip(w * ch / cw, 160, FFMAX(ub.h / 2, 160));
+    {                                           /* v37: the place and width it was left at, if that is still on a screen */
+        int lx, ly, lw, k, nd = SDL_GetNumVideoDisplays(), ok = 0;
+        SDL_Rect lb;
+
+        px = ub.x + ub.w - w - 24;
+        py = ub.y + ub.h - h - 24;
+        if (ui_pip_load(&lx, &ly, &lw)) {
+            for (k = 0; k < nd && !ok; k++) {
+                if (SDL_GetDisplayUsableBounds(k, &lb) != 0)
+                    continue;
+                if (lx + lw / 2 >= lb.x && lx + lw / 2 < lb.x + lb.w && ly + 40 >= lb.y && ly + 40 < lb.y + lb.h) {
+                    lw = av_clip(lw, 240, lb.w);
+                    w = lw;
+                    h = av_clip(w * ch / cw, 120, lb.h);
+                    px = av_clip(lx, lb.x, lb.x + lb.w - w);
+                    py = av_clip(ly, lb.y, lb.y + lb.h - h);
+                    ok = 1;
+                }
+            }
+        }
+    }
+    SDL_SetWindowSize(window, w, h);
+    SDL_SetWindowPosition(window, px, py);
+    ui_prog_w = w;
+    ui_prog_h = h;
+    ui_pip_was_top = ui_on_top;
+    SDL_SetWindowAlwaysOnTop(window, SDL_TRUE);
+    ui_on_top = 1;
+    ui_pip = 1;
+    ui_user_sized = 1;                          /* the next items of the queue keep the miniplayer's size */
+    ui_keep_w = w;
+    ui_keep_h = h;
+    if (is)
+        is->force_refresh = 1;
+}
+
+static void ui_titlebar_draw(VideoState *is)
+{
+    SDL_Rect row;
+    char name[300];
+    int w, h, y, a, sx, sy, cy = UI_TB_H / 2, cx1 = UI_TB_PAD + UI_TB_BTN / 2, cx2;
+
+    ui_tb_on = 0;
+    ui_tb_hover = 0;
+    if (!window || cursor_hidden || is_full_screen || ui_grow_on)     /* windowed mode only; hides with the cursor like the seek bar */
+        return;
+    SDL_GetWindowSize(window, &w, &h);
+    if (w < 260 || h < UI_MIN_H)
+        return;
+    ui_tb_on = 1;
+    cx2 = w - UI_TB_PAD - UI_TB_BTN / 2;
+    {                                           /* which button is the mouse over? */
+        int mx, my;
+
+        SDL_GetMouseState(&mx, &my);
+        if (my >= UI_TB_EDGE && my < UI_TB_H)
+            ui_tb_hover = (mx >= UI_TB_PAD && mx < UI_TB_PAD + UI_TB_BTN) ? 1 :
+                          (mx >= w - UI_TB_PAD - UI_TB_BTN && mx < w - UI_TB_PAD) ? 2 :
+                          (mx >= w - UI_TB_PAD - 2 * UI_TB_BTN && mx < w - UI_TB_PAD - UI_TB_BTN) ? 3 : 0;
+    }
+    SDL_SetRenderDrawBlendMode(renderer, SDL_BLENDMODE_BLEND);
+    row.x = 0;
+    row.w = w;
+    row.h = 1;
+    for (y = 0; y < UI_TB_H + 10; y++) {        /* a dark glass strip that fades out along its lower edge */
+        a = y < UI_TB_H ? 125 : 125 * (UI_TB_H + 10 - y) / 10;
+        row.y = y;
+        SDL_SetRenderDrawColor(renderer, 0, 0, 0, a);
+        SDL_RenderFillRect(renderer, &row);
+    }
+
+    if (ui_tb_hover)                            /* a soft round highlight under the button the mouse is over */
+        ui_fan(ui_tb_hover == 1 ? cx1 : ui_tb_hover == 3 ? cx2 - UI_TB_BTN : cx2, cy, 12, 0, 6.28318531, 28, 255, 255, 255, 40);
+
+    SDL_SetRenderDrawColor(renderer, 245, 245, 245, ui_tb_hover == 1 ? 255 : 200);      /* close: a cross */
+    ui_tb_line(cx1 - 5, cy - 5, cx1 + 5, cy + 5, 1.8);
+    ui_tb_line(cx1 - 5, cy + 5, cx1 + 5, cy - 5, 1.8);
+
+    SDL_SetRenderDrawColor(renderer, 245, 245, 245, ui_tb_hover == 2 ? 255 : 200);
+    for (sx = -1; sx <= 1; sx += 2)
+        for (sy = -1; sy <= 1; sy += 2) {
+            if (!is_full_screen) {              /* four corners pointing out: go fullscreen */
+                ui_tb_line(cx2 + sx * 6, cy + sy * 6, cx2 + sx * 2, cy + sy * 6, 1.8);
+                ui_tb_line(cx2 + sx * 6, cy + sy * 6, cx2 + sx * 6, cy + sy * 2, 1.8);
+            } else {                            /* four corners pointing in: leave fullscreen */
+                ui_tb_line(cx2 + sx * 2, cy + sy * 2, cx2 + sx * 7, cy + sy * 2, 2.0);
+                ui_tb_line(cx2 + sx * 2, cy + sy * 2, cx2 + sx * 2, cy + sy * 7, 2.0);
+            }
+        }
+
+    {                                           /* picture in picture: a window with a small window in its corner */
+        int px = cx2 - UI_TB_BTN;
+        SDL_Rect corner;
+
+        SDL_SetRenderDrawColor(renderer, 245, 245, 245, ui_tb_hover == 3 ? 255 : 200);
+        ui_tb_line(px - 7, cy - 5, px + 7, cy - 5, 1.6);
+        ui_tb_line(px - 7, cy + 5, px + 7, cy + 5, 1.6);
+        ui_tb_line(px - 7, cy - 5, px - 7, cy + 5, 1.6);
+        ui_tb_line(px + 7, cy - 5, px + 7, cy + 5, 1.6);
+        corner.x = px + 1;
+        corner.y = cy;
+        corner.w = 6;
+        corner.h = 5;
+        SDL_RenderFillRect(renderer, &corner);
+    }
+    if (ui_on_top)                              /* a small dot: the window stays on top */
+        ui_fan(cx2 - UI_TB_BTN / 2 - 6, cy, 3, 0, 6.28318531, 16, av_clip(cfg_bar_r + 60, 0, 255),
+               av_clip(cfg_bar_g + 60, 0, 255), av_clip(cfg_bar_b + 60, 0, 255), 230);
+    if (is && q_pos >= 0 && q_pos < q_count)    /* the name of what plays, in the middle */
+        ui_q_name(q_pos, name, sizeof(name));
+    else
+        snprintf(name, sizeof(name), "ffplay-custom");
+    ui_fit_text(name, 14, w - 2 * (UI_TB_PAD + 2 * UI_TB_BTN + 16));
+    ui_label_c(w / 2, cy, name, 14, 235, 235, 235, 210);
+    SDL_SetRenderDrawBlendMode(renderer, SDL_BLENDMODE_NONE);
+}
+
+/* Tells SDL which part of the window moves it: the strip between the two buttons. The window manager then does the move. */
+static SDL_HitTestResult SDLCALL ui_hit_test(SDL_Window *win, const SDL_Point *area, void *data)
+{
+    int w, h;
+
+    if (!ui_tb_on || is_full_screen)
+        return SDL_HITTEST_NORMAL;
+    SDL_GetWindowSize(win, &w, &h);
+    if (area->y >= UI_TB_EDGE && area->y < UI_TB_H && area->x >= UI_TB_PAD + UI_TB_BTN && area->x < w - UI_TB_PAD - 2 * UI_TB_BTN)
+        return SDL_HITTEST_DRAGGABLE;
+    return SDL_HITTEST_NORMAL;
+}
+
+/* The window manager's own window menu (always on top, show on all workspaces, move to workspace, move, resize,
+   maximize, minimize, close) at the mouse. X11 sessions: the window manager is asked with _GTK_SHOW_WINDOW_MENU. */
+typedef struct {
+    int type;
+    unsigned long serial;
+    int send_event;
+    void *display;
+    unsigned long window;
+    unsigned long message_type;
+    int format;
+    long l[5];
+} UiXClientMsg;
+
+static void ui_wm_menu(void)
+{
+    SDL_SysWMinfo info;
+    static void *xlib = NULL;
+    static unsigned long (*x_atom)(void *, const char *, int);
+    static unsigned long (*x_root)(void *);
+    static int (*x_send)(void *, unsigned long, int, long, void *);
+    static int (*x_flush)(void *);
+    union { UiXClientMsg m; long pad[24]; } ev;
+    int gx, gy;
+
+    SDL_VERSION(&info.version);
+    if (!window || !SDL_GetWindowWMInfo(window, &info))
+        return;
+    if (info.subsystem != SDL_SYSWM_X11) {      /* no window manager menu to ask for: the one thing it would give us here */
+        ui_toggle_on_top();
+        return;
+    }
+    if (!xlib) {
+        xlib = dlopen("libX11.so.6", RTLD_LAZY);
+        if (xlib) {
+            *(void **)&x_atom = dlsym(xlib, "XInternAtom");
+            *(void **)&x_root = dlsym(xlib, "XDefaultRootWindow");
+            *(void **)&x_send = dlsym(xlib, "XSendEvent");
+            *(void **)&x_flush = dlsym(xlib, "XFlush");
+        }
+    }
+    if (!x_atom || !x_root || !x_send || !x_flush)
+        return;
+    SDL_GetGlobalMouseState(&gx, &gy);
+    memset(&ev, 0, sizeof(ev));
+    ev.m.type = 33;                             /* ClientMessage */
+    ev.m.display = info.info.x11.display;
+    ev.m.window = info.info.x11.window;
+    ev.m.message_type = x_atom(info.info.x11.display, "_GTK_SHOW_WINDOW_MENU", 0);
+    ev.m.format = 32;
+    ev.m.l[0] = 0;                              /* the pointer device */
+    ev.m.l[1] = gx;
+    ev.m.l[2] = gy;
+    x_send(info.info.x11.display, x_root(info.info.x11.display), 0, (1L << 20) | (1L << 19), &ev);   /* SubstructureRedirect | SubstructureNotify */
+    x_flush(info.info.x11.display);
+}
+
+/* Clicks on the two buttons. Returns 1 if the click was used. */
+static int ui_titlebar_mouse(VideoState *is, SDL_Event *ev)
+{
+    int w, h, x, y, hover = 0;
+
+    if (!ui_tb_on || !window || (ev->type != SDL_MOUSEBUTTONDOWN && ev->type != SDL_MOUSEMOTION))
+        return 0;
+    SDL_GetWindowSize(window, &w, &h);
+    x = ev->type == SDL_MOUSEMOTION ? ev->motion.x : ev->button.x;
+    y = ev->type == SDL_MOUSEMOTION ? ev->motion.y : ev->button.y;
+    if (y >= UI_TB_EDGE && y < UI_TB_H)
+        hover = (x >= UI_TB_PAD && x < UI_TB_PAD + UI_TB_BTN) ? 1 : (x >= w - UI_TB_PAD - UI_TB_BTN && x < w - UI_TB_PAD) ? 2 :
+                (x >= w - UI_TB_PAD - 2 * UI_TB_BTN && x < w - UI_TB_PAD - UI_TB_BTN) ? 3 : 0;
+    if (ev->type == SDL_MOUSEMOTION) {
+        if (hover != ui_tb_hover && is)
+            is->force_refresh = 1;
+        ui_tb_hover = hover;
+        return 0;                               /* the others still see the movement */
+    }
+    if (ev->button.button == SDL_BUTTON_RIGHT && y < UI_TB_H) {
+        ui_wm_menu();                           /* right click on the title bar: the window manager's menu */
+        return 1;
+    }
+    if (ev->button.button != SDL_BUTTON_LEFT || !hover)
+        return 0;
+    if (hover == 1) {
+        SDL_Event quit;
+
+        memset(&quit, 0, sizeof(quit));
+        quit.type = SDL_QUIT;
+        SDL_PushEvent(&quit);                   /* the same as closing the window any other way */
+    } else if (hover == 3) {
+        ui_pip_toggle(is);
+        if (is)
+            is->force_refresh = 1;
+    } else {
+        toggle_full_screen(is);
+        if (is)
+            is->force_refresh = 1;
+    }
+    return 1;
+}
+
+/* Mouse events for resizing the window by its edges and corners (moving it is the title bar's job).
+   Returns 1 if the event was used here, 0 if normal handling should go on. */
+static int ui_window_mouse(VideoState *is, SDL_Event *ev)
+{
+    int gx, gy;
+    int edges;
+
+    if (is_full_screen) {
+        if (ui_win_mode) {
+            ui_win_mode = 0;
+            SDL_CaptureMouse(SDL_FALSE);
+        }
+        ui_set_cursor(0);
+        return 0;
+    }
+
+    SDL_GetGlobalMouseState(&gx, &gy);
+
+    if (ev->type == SDL_MOUSEBUTTONDOWN) {
+        if (ev->button.button != SDL_BUTTON_LEFT)
+            return 0;
+        edges = ui_edges_at(ev->button.x, ev->button.y);
+        if (!edges)
+            return 0;                   /* only the edges and corners are ours; a click on the picture goes on */
+        if (ui_maxed)
+            ui_max_set(0);              /* the window gets its own size back, and the corner is dragged from there */
+        ui_win_mode = 2;
+        ui_win_edges = edges;
+        ui_gx0 = gx;
+        ui_gy0 = gy;
+        SDL_GetWindowPosition(window, &ui_wx0, &ui_wy0);
+        SDL_GetWindowSize(window, &ui_ww0, &ui_wh0);
+        SDL_CaptureMouse(SDL_TRUE);
+        return 1;
+    }
+    if (ev->type == SDL_MOUSEMOTION) {
+        if (ui_win_mode == 2) {
+            ui_resize_to(is, gx, gy);
+            ui_wake();
+            return 1;
+        }
+        /* Not resizing: show a resize cursor over the edges */
+        ui_set_cursor(ui_edges_at(ev->motion.x, ev->motion.y));
+        return 0;
+    }
+    if (ev->type == SDL_MOUSEBUTTONUP && ev->button.button == SDL_BUTTON_LEFT && ui_win_mode) {
+        ui_win_mode = 0;
+        SDL_CaptureMouse(SDL_FALSE);
+        return 1;
+    }
+    return 0;
+}
+
+/* The idle screen: logo and menu. Returns when something has been added to the queue. */
+static void ui_idle_loop(void)
+{
+    SDL_Event ev;
+
+    if (!window)
+        do_exit(NULL);              /* no window to show (-nodisp) */
+
+    /* The window starts hidden, so show it. Keep its size if it was already open. */
+    if (!ui_shown_once && (!SDL_GetWindowFlags(window) || !(SDL_GetWindowFlags(window) & SDL_WINDOW_SHOWN))) {
+        SDL_SetWindowTitle(window, "ffplay-custom");
+        if (!is_full_screen)
+            SDL_SetWindowSize(window, 960, 540);
+        if (ui_start_max)
+            ui_max_set(1);                      /* v40: the idle screen opens as the window that fills the screen too */
+        SDL_ShowWindow(window);
+        ui_shown_once = 1;
+        if (is_full_screen)
+            SDL_SetWindowFullscreen(window, SDL_WINDOW_FULLSCREEN_DESKTOP);
+    }
+    if (cursor_hidden) {
+        SDL_ShowCursor(1);
+        cursor_hidden = 0;
+    }
+    SDL_SetWindowTitle(window, "ffplay-custom");      /* the idle screen has no item name */
+    ui_idle = 1;
+    ui_menu_open = 0;
+    ui_menu_hover = -1;
+    ui_q_open = 0;
+    ui_info_open = 0;
+    ui_open_open = 0;
+    ui_ctx_open = 0;
+    ui_q_drag = -1;
+
+    /* wait here until there is something to play (after a sleep stop: until the user picks something) */
+    while (queue_next() >= q_count || (q_hold && q_forced < 0)) {
+        ui_inbox_tick(NULL);
+        ui_power_tick(NULL);
+        ui_sleep_tick(NULL);
+        ui_mpris_tick(NULL);
+        ui_pk_scan_tick(NULL);
+        ui_q_autoscroll();
+        while (SDL_PollEvent(&ev)) {
+            if (ev.type != SDL_QUIT && ui_pk_event(NULL, &ev))      /* v44 */
+                continue;
+            if (ev.type != SDL_QUIT && ui_prefs_open && ui_prefs_event(NULL, &ev))      /* v46 */
+                continue;
+            switch (ev.type) {
+            case SDL_QUIT:
+                do_exit(NULL);
+                break;
+            case SDL_KEYDOWN:
+                ev.key.keysym.sym = ui_key_translate(ev.key.keysym.sym);   /* the keys chosen in settings.conf */
+                if (ev.key.keysym.sym == SDLK_ESCAPE) {
+                    if (ui_prefs_open || ui_q_open || ui_info_open || ui_open_open || ui_ctx_open) {
+                        ui_prefs_open = 0;
+                        ui_q_open = 0;
+                        ui_info_open = 0;
+                        ui_open_open = 0;
+                        ui_ctx_open = 0;
+                    } else if (is_full_screen) {
+                        toggle_full_screen(NULL);
+                    }
+                } else if (ev.key.keysym.sym == SDLK_q)
+                    do_exit(NULL);
+                else if (ev.key.keysym.sym == SDLK_f)
+                    toggle_full_screen(NULL);
+                break;
+            case SDL_WINDOWEVENT:
+                if (ev.window.event == SDL_WINDOWEVENT_SIZE_CHANGED) {
+                    screen_width  = ev.window.data1;    /* the next video opens at this size */
+                    screen_height = ev.window.data2;
+                    ui_note_size(ev.window.data1, ev.window.data2);
+                }
+                break;
+            case SDL_MOUSEWHEEL:
+                ui_queue_wheel(&ev);
+                break;
+            case SDL_MOUSEBUTTONDOWN:
+            case SDL_MOUSEMOTION:
+            case SDL_MOUSEBUTTONUP:
+                if (ev.type == SDL_MOUSEBUTTONUP && ui_queue_release(&ev))
+                    break;
+                if (ev.type != SDL_MOUSEBUTTONUP && ui_titlebar_mouse(NULL, &ev))
+                    break;
+                if (ev.type != SDL_MOUSEBUTTONUP && ui_menu_mouse(NULL, &ev))
+                    break;
+                ui_window_mouse(NULL, &ev);     /* edges to resize */
+                break;
+            default:
+                break;
+            }
+        }
+        ui_glass_frame(NULL);
+        SDL_Delay(16);
+    }
+    q_hold = 0;
+    ui_idle = 0;
+}
