+/* Do what a menu row says */
+static void ui_menu_action(VideoState *is, int item)
+{
+    if (item == UI_ROW_OPEN) {          /* Open: the choices appear beside it */
+        ui_open_open = 1;
+        ui_q_open = 0;
+        ui_info_open = 0;
+        return;
+    }
+    if (item == UI_ROW_QUEUE) {         /* Queue: show the queue panel */
+        ui_q_show();
+        ui_info_open = 0;
+        ui_open_open = 0;
+        return;
+    }
+    if (item == UI_ROW_INFO) {          /* Media Info: show the information panel */
+        ui_info_open = 1;
+        ui_q_open = 0;
+        ui_open_open = 0;
+        return;
+    }
+    ui_menu_open = 0;
+    ui_menu_hover = -1;
+    ui_q_open = 0;
+    ui_info_open = 0;
+    ui_open_open = 0;
+    if (item == UI_ROW_PREFS) {
+        ui_prefs_open = 1;
+        ui_prefs_hover = -1;
+    } else {
+        do_exit(is);                /* Quit */
+    }
+}
