+        ui_flow_drop = -1;
+    } else if (idx == q_pos) {
+        toggle_pause(is);
+    } else if (idx < q_count) {
+        q_forced = idx;
+        ui_end_current(is);
+    }
+    is->force_refresh = 1;
+    return 1;
+}
