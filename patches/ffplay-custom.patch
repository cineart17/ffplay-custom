+static double ui_pref_open[UI_PREF_ROWS];   /* 0 to 1: how far each row has changed into its list of choices */
+static double ui_pref_hv[UI_PREF_ROWS];     /* v47: 0 to 1: how far the title of each row has moved for the mouse on it */
+static double ui_pref_pop[UI_PREF_ROWS][10];    /* 0 to 1: how far each choice has risen under the mouse */
