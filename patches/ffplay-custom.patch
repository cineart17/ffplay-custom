+
+    if (!home)
+        return;
+    snprintf(path, sizeof(path), "%s/.config/ffplay-custom/settings.conf", home);
+    f = fopen(path, "w");
+    if (!f)
+        return;
+    fprintf(f, "# ffplay-custom settings. Lines starting with # are ignored.\n");
+    fprintf(f, "# Change a value, save the file, and start ffplay-custom again.\n\n");
+    fprintf(f, "# Volume change for each Up/Down press (the scale is 0 to 128)\nvolume_step = %d\n\n", cfg_vol_step);
+    fprintf(f, "# Seconds without mouse movement before the bars and cursor hide\nhide_seconds = %g\n\n",
+            cfg_hide_delay / 1000000.0);
+    fprintf(f, "# 1 = open in the conventional full screen (the window that fills the screen under the panel; a double tap goes to complete full screen), 0 = open in a normal window\nfullscreen = %d\n\n", cfg_fullscreen);
+    fprintf(f, "# 1 = in a file with close key frames the Left/Right keys step 1 second and land exactly on their time, 0 = ffplay's own seek (to a key frame) always\nexact_seek = %d\n\n", cfg_exact_seek);
+    fprintf(f, "# 1 = Open File, Open Folder and Add to Queue use the player's own picker, 0 = the system's dialog (needs zenity)\npicker = %d\n\n", cfg_picker);
+    fprintf(f, "# The file picker: 1 = grid view, 0 = list; sorted by 0 name, 1 modified, 2 size; 1 = the other way round\npicker_grid = %d\npicker_sort = %d\npicker_desc = %d\n# 1 = the grid view shows pictures from the videos, the covers of songs and a picture from inside each folder, 0 = icons only (Ctrl+T in the picker)\npicker_thumbs = %d\n\n", cfg_pk_grid, cfg_pk_sort, cfg_pk_desc, cfg_pk_thumbs);
+    fprintf(f, "# 1 = letters are placed with sub-pixel accuracy (tighter, crisper titles), 0 = the older rendering\ncrisp_text = %d\n\n", cfg_crisp);
+    fprintf(f, "# How strong the smoked veil under the glass is (0 to 100), and how round the corners are (0 = square, 100 = as before)\nglass_tint = %d\nroundness = %d\n\n", cfg_tint, cfg_round);
+    fprintf(f, "# Color of the filled part of the bars: red green blue (0 to 255 each)\nbar_color = %d %d %d\n\n",
+            cfg_bar_r, cfg_bar_g, cfg_bar_b);
+    fprintf(f, "# 1 = remember the volume between runs, 0 = always start at full volume\nremember_volume = %d\n\n",
+            cfg_remember_volume);
+    fprintf(f, "# 1 = quit when the queue ends, 0 = show the idle screen\nquit_when_done = %d\n\n", cfg_quit_when_done);
+    fprintf(f, "# Scroll action (mouse wheel and two finger swipes up and down): 0 = seek by the seek step, 1 = volume, 2 = navigation (a swipe up opens the tiled view)\nscroll_action = %d\n\n", cfg_wheel);
+    fprintf(f, "# Seconds the end of one item and the start of the next overlap (0 = off, 10 at most)\ncrossfade = %d\n\n",
+            cfg_crossfade);
+    fprintf(f, "# Folders the search of the tiled queue view looks in (empty = the system's Music and Videos folders)\nmusic_folder = %s\nvideo_folder = %s\n\n",
+            cfg_music_dir, cfg_video_dir);
+    ui_key_save(f);
+    fprintf(f, "# Font file for the text (leave empty to use the system font)\nfont = %s\n", cfg_font);
+    fclose(f);
+}
