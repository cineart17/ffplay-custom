+        /* the x that removes the item */
+        SDL_SetRenderDrawColor(renderer, 230, 230, 230, (int)(((lit && hk == UI_Q_DEL) ? 255 : 120) * ui_fade));
+        ui_q_line(right - 71, cy - 4, right - 63, cy + 4);
+        ui_q_line(right - 71, cy + 4, right - 63, cy - 4);
