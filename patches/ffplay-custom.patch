+/* Seek by incr seconds: the same as the Left and Right arrow keys */
+static void ui_seek_relative(VideoState *is, double incr)
+{
+    double pos;
+
+    if (seek_by_bytes) {
+        pos = -1;
+        if (pos < 0 && is->video_stream >= 0)
+            pos = frame_queue_last_pos(&is->pictq);
+        if (pos < 0 && is->audio_stream >= 0)
+            pos = frame_queue_last_pos(&is->sampq);
+        if (pos < 0)
+            pos = avio_tell(is->ic->pb);
+        if (is->ic->bit_rate)
+            incr *= is->ic->bit_rate / 8.0;
+        else
+            incr *= 180000.0;
+        pos += incr;
+        stream_seek(is, pos, incr, 1);
+    } else {
+        pos = get_master_clock(is);             /* v39: exactly what ffplay does */
+        if (isnan(pos))
+            pos = (double)is->seek_pos / AV_TIME_BASE;
+        pos += incr;
+        if (is->ic->start_time != AV_NOPTS_VALUE && pos < is->ic->start_time / (double)AV_TIME_BASE)
+            pos = is->ic->start_time / (double)AV_TIME_BASE;
+        ui_precise_next = is->ui_seek_exact &&  /* v41: close key frames: land exactly (not in the last second: nothing there would reach the time) */
+                          (is->ic->duration <= 0 || pos < ((is->ic->start_time != AV_NOPTS_VALUE ? is->ic->start_time : 0) + is->ic->duration) / (double)AV_TIME_BASE - 1.0);
+        stream_seek(is, (int64_t)(pos * AV_TIME_BASE), (int64_t)(incr * AV_TIME_BASE), 0);
+        is->force_refresh = 1;
+    }
+}
+
+/* Where the mouse is on the bottom strip: 1 = on the seek bar, 2 = on the volume bar, 0 = elsewhere */
+static int ui_wheel_zone(VideoState *is)
+{
+    SDL_Rect sk, vo;
+    int mx, my;
+
+    if (!is || !UI_ON(is))
+        return 0;
+    SDL_GetMouseState(&mx, &my);
+    if (my < is->height - UI_BAR_H)
+        return 0;
+    ui_layout(is, &sk, &vo);
+    if (mx >= vo.x - 10 && mx <= vo.x + vo.w + 10)
+        return 2;
+    if (mx >= sk.x - 10 && mx <= sk.x + sk.w + 10)
+        return 1;
+    return 0;
+}
