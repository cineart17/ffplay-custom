+static void video_display(VideoState *is)
+{
+    if (!is->width)
+        video_open(is);
+
+    if (ui_win_unseen())
+        return;                     /* minimized or hidden: nothing to draw */
+
+    {                                           /* the window's real size wins: a picture sized for an old window sits small in a corner */
+        static int64_t since = 0;
+        int cw, ch;
+
+        SDL_GetWindowSize(window, &cw, &ch);
+        if (cw > 0 && ch > 0 && (cw != is->width || ch != is->height)) {
+            int64_t t_ = av_gettime_relative();
+
+            if (!since) {
+                since = t_;
+            } else if (t_ - since > 300000) {   /* not a size change on its way: follow the window */
+                av_log(NULL, AV_LOG_WARNING, "ffplay-custom: the picture was sized for %dx%d but the window is %dx%d: following the window\n",
+                       is->width, is->height, cw, ch);
+                screen_width = is->width = cw;
+                screen_height = is->height = ch;
+                if (is->vis_texture) {
+                    SDL_DestroyTexture(is->vis_texture);
+                    is->vis_texture = NULL;
+                }
+                since = 0;
+            }
+        } else {
+            since = 0;
+        }
+    }
+
+    if (ui_bg) {                    /* out of sight: one picture in a while shows whether the window is back */
+        int64_t now = av_gettime_relative();
+
+        if (now - ui_bg_probe < 8000000)
+            return;
+        ui_bg_probe = now;          /* one picture, drawn without waiting for the screen */
+    }
+
+    if (ui_too_small() && (ui_menu_open || ui_prefs_open || ui_q_open || ui_info_open || ui_open_open || ui_ctx_open || ui_tvc_open ||
+                           ui_vflow || ui_tv_audio)) {
+        ui_menu_open = ui_prefs_open = ui_q_open = ui_info_open = ui_open_open = ui_ctx_open = ui_tvc_open = 0;       /* v41 */
+        ui_tv_audio = 0;
+        ui_vflow_auto = 0;
+        ui_vflow_set(is, 0);
+        ui_menu_hover = -1;
+        is->force_refresh = 1;
+    }
+
+    if (ui_menu_open || ui_prefs_open || ui_pk_open) {
+        ui_glass_frame(is);         /* frosted glass over the blurred picture */
+        return;
+    }
+
+    {                                           /* the glass of the bars and the soft blur need the picture as a texture */
+        int ww, wh, scene = (UI_ON(is) && is->ic && !cursor_hidden) || ui_wblur > 0.01;
+
+        SDL_GetWindowSize(window, &ww, &wh);
+        if (scene) {
+            ui_glass_resize(ww, wh);
+            scene = ui_scene_tex != NULL;
+        }
+        if (scene)
+            SDL_SetRenderTarget(renderer, ui_scene_tex);
+        SDL_SetRenderDrawColor(renderer, 0, 0, 0, 255);
+        SDL_RenderClear(renderer);
+        {
+            int full_h = is->height;
+
+            /* The bars float over the video, so the video uses the whole window */
+            if (is->audio_st && is->show_mode != SHOW_MODE_VIDEO)
+                video_audio_display(is);
+            else if (is->video_st)
+                video_image_display(is);
+            is->height = full_h;
+        }
+        ui_flow_draw(is);
+        if (scene) {
+            SDL_SetRenderTarget(renderer, NULL);
+            SDL_RenderCopy(renderer, ui_scene_tex, NULL, NULL);
+            ui_glass_blur();
+            if (ui_wblur > 0.01 && ui_blur_tex[1] && ui_blur_tex[2]) {  /* the blur of a window that was left */
+                double wb = FFMIN(ui_wblur, 1.0);
+                int k;
+
+                for (k = 1; k <= 2; k++) {      /* the soft blur (1/4 size) comes in first, the strong one (1/8) follows it */
+                    double a = k == 1 ? FFMIN(wb * 1.5, 1.0) : FFMAX((wb - 0.4) / 0.6, 0.0);
+
+                    if (a <= 0.0)
+                        continue;
+                    SDL_SetTextureBlendMode(ui_blur_tex[k], SDL_BLENDMODE_BLEND);
+                    SDL_SetTextureAlphaMod(ui_blur_tex[k], (int)(255 * a));
+                    SDL_RenderCopy(renderer, ui_blur_tex[k], NULL, NULL);
+                    SDL_SetTextureAlphaMod(ui_blur_tex[k], 255);
+                    SDL_SetTextureBlendMode(ui_blur_tex[k], SDL_BLENDMODE_NONE);
+                }
+            }
+        }
+    }
+    ui_draw(is);
+    ui_titlebar_draw(is);
+    ui_menu_stream = is;
+    ui_menu_draw();
+    ui_present();
