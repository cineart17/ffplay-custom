+    cy = p.y + UI_Q_PAD + UI_Q_HEAD / 2;
+    ui_label(p.x + 20, cy, "Add to queue...", 20, 240, 240, 240, hk == UI_Q_ADD ? 255 : 210);
+    ui_transport_icon(0, right - 156, cy, hk == UI_Q_PREV ? 255 : 175);
