+static void ui_th_stop(void)
+{
+    int i;
+
+    if (ui_th.thread) {
+        ui_th.abort = 1;
+        SDL_WaitThread(ui_th.thread, NULL);
+        ui_th.thread = NULL;
+    }
+    for (i = 0; i < UI_TH_MAX; i++) {
