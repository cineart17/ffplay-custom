+static void ui_ink(int *r, int *g, int *b)
+{
+    if (ui_ink_dark && FFMIN3(*r, *g, *b) >= 100 && FFMAX3(*r, *g, *b) - FFMIN3(*r, *g, *b) <= 40) {
+        *r = (255 - *r) * 8 / 10;
+        *g = (255 - *g) * 8 / 10;
+        *b = (255 - *b) * 8 / 10;
+    }
