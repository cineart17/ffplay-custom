+/* ---- sharp text (SDL2_ttf), frosted glass and the Preferences panel ---- */
+#include <SDL_ttf.h>
+#include <time.h>
+
+/* ----- sharp text ----- */
+#define UI_FONTS_MAX 8
+#define UI_TEXT_CACHE 320
+static int ui_ttf_state = 0;            /* 0 = not tried yet, 1 = working, -1 = not available */
+static char ui_font_path[512];
+static struct { int px; TTF_Font *font; } ui_fonts[UI_FONTS_MAX];
+static struct { char s[96]; int px; SDL_Texture *tex; int w, h; } ui_tc[UI_TEXT_CACHE];
+static int ui_tc_next = 0;
+
+/* Find a font file and start SDL_ttf. If anything fails we keep using the pixel font. */
+static void ui_ttf_init(void)
+{
+    static const char *fallbacks[] = { "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
+                                       "/usr/share/fonts/TTF/DejaVuSans.ttf", NULL };
+    char path[512] = "";
+    FILE *p;
+    int i;
+
+    ui_ttf_state = -1;
+    if (TTF_Init() != 0)
+        return;
+    if (cfg_font[0])
+        snprintf(path, sizeof(path), "%s", cfg_font);
+    if (!path[0] || access(path, R_OK) != 0) {
+        /* ask fontconfig for the system's default sans-serif font */
+        path[0] = 0;
+        p = popen("fc-match -f '%{file}' sans-serif 2>/dev/null", "r");
+        if (p) {
+            if (!fgets(path, sizeof(path), p))
+                path[0] = 0;
+            pclose(p);
+        }
+    }
+    for (i = 0; fallbacks[i] && (!path[0] || access(path, R_OK) != 0); i++)
+        snprintf(path, sizeof(path), "%s", fallbacks[i]);
+    if (access(path, R_OK) != 0)
+        return;
+    snprintf(ui_font_path, sizeof(ui_font_path), "%s", path);
+    ui_ttf_state = 1;
+}
+
+/* The font at a given pixel height (opened once, then kept) */
+static TTF_Font *ui_font(int px)
+{
+    int i;
+
+    if (ui_ttf_state == 0)
+        ui_ttf_init();
+    if (ui_ttf_state < 0)
+        return NULL;
+    for (i = 0; i < UI_FONTS_MAX && ui_fonts[i].font; i++)
+        if (ui_fonts[i].px == px)
+            return ui_fonts[i].font;
+    if (i == UI_FONTS_MAX)
+        return NULL;
+    ui_fonts[i].font = TTF_OpenFont(ui_font_path, px);
+    if (!ui_fonts[i].font) {
+        ui_ttf_state = -1;
+        return NULL;
+    }
+#ifdef TTF_HINTING_LIGHT_SUBPIXEL
+    TTF_SetFontHinting(ui_fonts[i].font, cfg_crisp ? TTF_HINTING_LIGHT_SUBPIXEL : TTF_HINTING_LIGHT);
+#else
+    TTF_SetFontHinting(ui_fonts[i].font, cfg_crisp ? TTF_HINTING_NORMAL : TTF_HINTING_LIGHT);
+#endif
+    TTF_SetFontKerning(ui_fonts[i].font, 1);
+    ui_fonts[i].px = px;
+    return ui_fonts[i].font;
+}
+
+/* A texture with the text drawn in white (kept in a small cache). NULL if there is no font. */
+static SDL_Texture *ui_text_tex(const char *s, int px, int *w, int *h)
+{
+    TTF_Font *font = ui_font(px);
+    SDL_Color white = { 255, 255, 255, 255 };
+    SDL_Surface *surf;
+    int i;
+
+    if (!font || !*s)
+        return NULL;
+    for (i = 0; i < UI_TEXT_CACHE; i++)
+        if (ui_tc[i].tex && ui_tc[i].px == px && !strcmp(ui_tc[i].s, s)) {
+            *w = ui_tc[i].w;
+            *h = ui_tc[i].h;
+            return ui_tc[i].tex;
+        }
+    surf = TTF_RenderUTF8_Blended(font, s, white);
+    if (!surf)
+        return NULL;
+    i = ui_tc_next;
+    ui_tc_next = (ui_tc_next + 1) % UI_TEXT_CACHE;
+    if (ui_tc[i].tex)
+        SDL_DestroyTexture(ui_tc[i].tex);
+    ui_tc[i].tex = SDL_CreateTextureFromSurface(renderer, surf);
+    snprintf(ui_tc[i].s, sizeof(ui_tc[i].s), "%s", s);
+    ui_tc[i].px = px;
+    ui_tc[i].w = *w = surf->w;
+    ui_tc[i].h = *h = surf->h;
+    SDL_FreeSurface(surf);
+    return ui_tc[i].tex;
+}
+
+/* Width of a text in pixels */
+static int ui_text_width(const char *s, int px)
+{
+    int w = 0, h = 0;
+    TTF_Font *font = ui_font(px);
+
+    if (font && TTF_SizeUTF8(font, s, &w, &h) == 0)
+        return w;
+    return (int)strlen(s) * 8 * (px < 20 ? 1 : 2);      /* pixel font */
+}
+
+/* Draw text with its left edge at x and its middle at cy. px = text height in pixels. */
+static void ui_label(int x, int cy, const char *s, int px, int r, int g, int b, int a)
+{
+    int w = 0, h = 0;
+    SDL_Texture *tex = ui_text_tex(s, px, &w, &h);
+    SDL_Rect dst;
+
+    a = (int)(a * ui_fade);
+
+    if (!tex) {
+        /* no font available: use the pixel font */
+        SDL_SetRenderDrawColor(renderer, r, g, b, a);
+        if (px < 20)
+            ui_text(x, cy - 8, s);
+        else
+            ui_text_big(x, cy - 16, s, 2);
+        return;
+    }
+    dst.x = x;
+    dst.y = cy - h / 2;
+    dst.w = w;
+    dst.h = h;
+    ui_ink(&r, &g, &b);                         /* dark text on the light glass */
+    SDL_SetTextureColorMod(tex, r, g, b);
+    SDL_SetTextureAlphaMod(tex, a);
+    SDL_RenderCopy(renderer, tex, NULL, &dst);
+}
+
+/* Draw text with its middle at cx */
+static void ui_label_c(int cx, int cy, const char *s, int px, int r, int g, int b, int a)
+{
+    ui_label(cx - ui_text_width(s, px) / 2, cy, s, px, r, g, b, a);
+}
+
+/* v47: the same, grown by sc around its own centre (1.0 = as it is): the pop of a choice under the mouse */
+static void ui_label_cs(int cx, int cy, const char *s, int px, int r, int g, int b, int a, double sc)
+{
+    int w = 0, h = 0;
+    SDL_Texture *tex;
+    SDL_Rect dst;
+
+    tex = sc > 1.004 ? ui_text_tex(s, px, &w, &h) : NULL;
+    if (!tex) {
+        ui_label_c(cx, cy, s, px, r, g, b, a);
+        return;
+    }
+    a = (int)(a * ui_fade);
+    dst.w = (int)(w * sc + 0.5);
+    dst.h = (int)(h * sc + 0.5);
+    dst.x = cx - dst.w / 2;
+    dst.y = cy - dst.h / 2;
+    ui_ink(&r, &g, &b);                         /* dark text on the light glass */
+    SDL_SetTextureColorMod(tex, r, g, b);
+    SDL_SetTextureAlphaMod(tex, a);
+    SDL_RenderCopy(renderer, tex, NULL, &dst);
+}
+
+/* A soft arrowhead for the menus: a flat, fine chevron with a faint halo, pointing left (dir = -1) or
+   right (dir = 1). cx, cy = its middle. a = how strong it is (0 to 255). */
+static void ui_arrow(int cx, int cy, int dir, int a)
+{
+    int k, tail = cx - dir * 3, tip = cx + dir * 3, h = 5;
+
+    a = av_clip((int)(a * ui_fade), 0, 255);       /* (a can arrive below 0 while the menu fades in) */
+    for (k = -1; k <= 1; k++) {
+        SDL_SetRenderDrawColor(renderer, 225, 225, 225, k ? a / 5 : a);
+        SDL_RenderDrawLine(renderer, tail, cy - h + k, tip, cy + k);
+        SDL_RenderDrawLine(renderer, tip, cy + k, tail, cy + h + k);
+    }
+}
+
+/* ----- line icons -----
+   Thin single-line icons for the menus. Each one is a few strokes (lines and arcs) on a 24 x 24 grid, drawn once for each size
+   into a small texture with smooth edges, and tinted when it is drawn. */
+enum { UI_IC_OPEN, UI_IC_FOLDER, UI_IC_FILE, UI_IC_QUEUE, UI_IC_INFO, UI_IC_GEAR, UI_IC_POWER, UI_IC_TRASH, UI_IC_MOON,
+       UI_IC_FADE, UI_IC_SKIP, UI_IC_VOLUME, UI_IC_EYE, UI_IC_EXPAND, UI_IC_DROP, UI_IC_BOOKMARK, UI_IC_EXIT, UI_IC_MOUSE,
+       UI_IC_CHEV_R, UI_IC_CHEV_D, UI_IC_CHEV_U, UI_IC_X,
+       UI_IC_CHEV_L,
+       UI_IC_GRID, UI_IC_LIST, UI_IC_SEARCH, UI_IC_ARR_L, UI_IC_ARR_R, UI_IC_ARR_U, UI_IC_EJECT,
+       UI_IC_N };
+#define UI_IC_MAXS 80
+typedef struct { float a, b, c, d, e, f; int arc; } UiStroke;       /* a line (a,b to c,d) or an arc (centre a,b, radius c, angles e to f) */
+static UiStroke ui_is[UI_IC_MAXS];
+static int ui_is_n;
+
+static void ic_seg(float x0, float y0, float x1, float y1)
+{
+    UiStroke *s;
+
+    if (ui_is_n >= UI_IC_MAXS)
+        return;
+    s = &ui_is[ui_is_n++];
+    s->a = x0; s->b = y0; s->c = x1; s->d = y1; s->e = s->f = 0.0f; s->arc = 0;
+}
+
+static void ic_arc(float cx, float cy, float r, float a0, float a1)
+{
+    UiStroke *s;
+
+    if (ui_is_n >= UI_IC_MAXS)
+        return;
+    s = &ui_is[ui_is_n++];
+    s->a = cx; s->b = cy; s->c = r; s->d = 0.0f; s->e = a0; s->f = a1; s->arc = 1;
+}
+
+static void ic_poly(const float *p, int n, int closed)
+{
+    int i;
+
+    for (i = 0; i + 1 < n; i++)
+        ic_seg(p[i * 2], p[i * 2 + 1], p[i * 2 + 2], p[i * 2 + 3]);
+    if (closed && n > 2)
+        ic_seg(p[(n - 1) * 2], p[(n - 1) * 2 + 1], p[0], p[1]);
+}
+
+static void ic_rrect(float x, float y, float w, float h, float r)
+{
+    ic_seg(x + r, y, x + w - r, y);
+    ic_seg(x + w, y + r, x + w, y + h - r);
+    ic_seg(x + r, y + h, x + w - r, y + h);
+    ic_seg(x, y + r, x, y + h - r);
+    ic_arc(x + r, y + r, r, 180, 270);
+    ic_arc(x + w - r, y + r, r, 270, 360);
+    ic_arc(x + w - r, y + h - r, r, 0, 90);
+    ic_arc(x + r, y + h - r, r, 90, 180);
+}
