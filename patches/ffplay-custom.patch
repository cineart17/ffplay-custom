+    if (!is || !is->ic || is->ic->duration <= 0 || is->seek_req)
+        return;
+    secs = av_clipd(secs, 0.0, FFMAX(is->ic->duration / (double)AV_TIME_BASE - 0.5, 0.0));
+    ts = (int64_t)(secs * AV_TIME_BASE);
