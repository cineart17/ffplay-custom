+    if ((what == 'o' || what == 'a') && stat(path, &st) == 0) {         /* v51: the folder it came from is a recent place */
+        char dir[PATH_MAX + 300], *slash;
+
+        snprintf(dir, sizeof(dir), "%s", path);
+        if (!S_ISDIR(st.st_mode) && (slash = strrchr(dir, '/')))
