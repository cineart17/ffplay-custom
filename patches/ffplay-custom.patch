+/* Which window edges is the point (x, y) near? Returns UI_EDGE_* values added together. */
+static int ui_edges_at(int x, int y)
+{
+    int w, h;
+    int e = 0;
+    int m = 5;      /* thickness of the edge zones */
+    int c = 16;     /* size of the corner zones */
+
+    SDL_GetWindowSize(window, &w, &h);
+    if (x < m)      e |= UI_EDGE_L;
+    if (x >= w - m) e |= UI_EDGE_R;
+    if (y < m)      e |= UI_EDGE_T;
+    if (y >= h - m) e |= UI_EDGE_B;
+    /* corners are bigger, so they are easy to grab */
+    if (x < c && y < c)           e = UI_EDGE_L | UI_EDGE_T;
+    if (x >= w - c && y < c)      e = UI_EDGE_R | UI_EDGE_T;
+    if (x < c && y >= h - c)      e = UI_EDGE_L | UI_EDGE_B;
+    if (x >= w - c && y >= h - c) e = UI_EDGE_R | UI_EDGE_B;
+    return e;
+}
+
+/* Show the right mouse cursor for the edges under the mouse */
+static void ui_set_cursor(int edges)
+{
+    int which = 0;      /* 0 = normal arrow */
+
+    if (edges == UI_EDGE_L || edges == UI_EDGE_R)
+        which = 1;      /* left-right arrows */
+    else if (edges == UI_EDGE_T || edges == UI_EDGE_B)
+        which = 2;      /* up-down arrows */
+    else if (edges == (UI_EDGE_L | UI_EDGE_T) || edges == (UI_EDGE_R | UI_EDGE_B))
+        which = 3;      /* diagonal, top-left to bottom-right */
+    else if (edges)
+        which = 4;      /* diagonal, top-right to bottom-left */
+
+    if (which == ui_cursor_now)
+        return;
+    ui_cursor_now = which;
+    if (!ui_cursors[which]) {
+        static const SDL_SystemCursor kinds[5] = {
+            SDL_SYSTEM_CURSOR_ARROW, SDL_SYSTEM_CURSOR_SIZEWE, SDL_SYSTEM_CURSOR_SIZENS,
+            SDL_SYSTEM_CURSOR_SIZENWSE, SDL_SYSTEM_CURSOR_SIZENESW
+        };
+        ui_cursors[which] = SDL_CreateSystemCursor(kinds[which]);
+    }
+    if (ui_cursors[which])
+        SDL_SetCursor(ui_cursors[which]);
+}
+
+/* Work out the new window size and position while dragging an edge or corner */
+static void ui_resize_to(VideoState *is, int gx, int gy)
+{
+    double ar = ui_video_aspect(is);
+    int dx = gx - ui_gx0;
+    int dy = gy - ui_gy0;
+    int horiz = ui_win_edges & (UI_EDGE_L | UI_EDGE_R);
+    int vert  = ui_win_edges & (UI_EDGE_T | UI_EDGE_B);
+    int x = ui_wx0, y = ui_wy0;
+    int w, h, wx, hy;
+    SDL_Rect area;
+
+    /* Width and height the mouse is asking for */
+    wx = ui_ww0;
+    hy = ui_wh0;
+    if (ui_win_edges & UI_EDGE_R) wx += dx;
+    if (ui_win_edges & UI_EDGE_L) wx -= dx;
+    if (ui_win_edges & UI_EDGE_B) hy += dy;
+    if (ui_win_edges & UI_EDGE_T) hy -= dy;
+    wx = FFMAX(wx, 320);
+    hy = FFMAX(hy, 180);
+
+    /* Biggest size that fits on the screen */
+    SDL_GetDisplayUsableBounds(SDL_GetWindowDisplayIndex(window), &area);
+
+    if (ar > 0.0) {
+        /* Video: choose the width, then get the height from the aspect ratio */
+        int from_h = (int)(hy * ar + 0.5);      /* width that matches the height asked for */
+
+        if (horiz && !vert)
+            w = wx;
+        else if (vert && !horiz)
+            w = from_h;
+        else
+            w = FFMAX(wx, from_h);              /* corner: follow the bigger one */
+        w = av_clip(w, 320, area.w);
+        h = (int)(w / ar + 0.5);
+        if (h > area.h) {                       /* too tall for the screen */
+            h = area.h;
+            w = (int)(h * ar + 0.5);
+        }
+    } else {
+        /* No video picture (audio file): resize freely */
+        w = FFMIN(wx, area.w);
+        h = FFMIN(hy, area.h);
+    }
+
+    /* Left and top edges: keep the opposite side where it was */
+    if (ui_win_edges & UI_EDGE_L) x = ui_wx0 + ui_ww0 - w;
+    if (ui_win_edges & UI_EDGE_T) y = ui_wy0 + ui_wh0 - h;
+
+    SDL_SetWindowPosition(window, x, y);
+    SDL_SetWindowSize(window, w, h);
+}
+
+/* Mouse events for moving and resizing the window.
+   Returns 1 if the event was used here, 0 if normal handling should go on. */
+/* Which screen edge is the mouse at? Top = fullscreen, left or right = that half of the screen. */
+static int ui_snap_zone_at(int gx, int gy)
+{
+    SDL_Rect b;
+
+    if (SDL_GetDisplayUsableBounds(SDL_GetWindowDisplayIndex(window), &b) != 0)
+        return 0;
+    if (gy <= b.y + 4)
+        return UI_SNAP_FULL;
+    if (gx <= b.x + 4)
+        return UI_SNAP_LEFT;
+    if (gx >= b.x + b.w - 5)
+        return UI_SNAP_RIGHT;
+    return 0;
+}
+
+/* Do the snap: fullscreen, or the left or right half of the screen */
+static void ui_snap_apply(int zone)
+{
+    SDL_Rect b;
+
+    if (SDL_GetDisplayUsableBounds(SDL_GetWindowDisplayIndex(window), &b) != 0)
+        return;
+    if (!ui_snapped) {                          /* remember the size from before the snap */
+        ui_prev_w = ui_ww0;
+        ui_prev_h = ui_wh0;
+    }
+    if (zone == UI_SNAP_FULL) {
+        SDL_SetWindowPosition(window, ui_wx0, ui_wy0);      /* leaving fullscreen puts it back where the drag began */
+        is_full_screen = 1;
+        SDL_SetWindowFullscreen(window, SDL_WINDOW_FULLSCREEN_DESKTOP);
+        return;
+    }
+    ui_snapped = 1;
+    SDL_SetWindowPosition(window, zone == UI_SNAP_LEFT ? b.x : b.x + b.w / 2, b.y);
+    SDL_SetWindowSize(window, b.w / 2, b.h);
+}
+
+/* Dragging a snapped window gives it its old size back, held by the same spot as before */
+static void ui_unsnap(int gx, int gy)
+{
+    double fx = ui_ww0 > 0 ? (ui_gx0 - ui_wx0) / (double)ui_ww0 : 0.5;
+    int oy = ui_gy0 - ui_wy0;                   /* how far below the top of the window it was grabbed */
+
+    ui_snapped = 0;
+    if (ui_prev_w < 320 || ui_prev_h < 180)
+        return;
+    SDL_SetWindowSize(window, ui_prev_w, ui_prev_h);
+    ui_ww0 = ui_prev_w;
+    ui_wh0 = ui_prev_h;
+    ui_wx0 = gx - (int)(fx * ui_prev_w);
+    ui_wy0 = gy - oy;
+    ui_gx0 = gx;
+    ui_gy0 = gy;
+}
+
+static int ui_window_mouse(VideoState *is, SDL_Event *ev)
+{
+    int gx, gy;
+    int edges;
+    int was_resize;
+
+    if (is_full_screen) {
+        if (ui_win_mode) {
+            ui_win_mode = 0;
+            SDL_CaptureMouse(SDL_FALSE);
+        }
+        ui_set_cursor(0);
+        return 0;
+    }
+
+    SDL_GetGlobalMouseState(&gx, &gy);
+
+    if (ev->type == SDL_MOUSEBUTTONDOWN) {
+        if (ev->button.button != SDL_BUTTON_LEFT)
+            return 0;
+        edges = ui_edges_at(ev->button.x, ev->button.y);
+        /* A click on the bar area belongs to the bars */
+        if (!edges && is && ev->button.y >= is->height - UI_BAR_H)
+            return 0;
+        if (!edges && is && ui_flow_cover_at(is, ev->button.x, ev->button.y) >= 0)
+            return 0;                   /* a press on a cover belongs to the queue view, not to moving the window */
+        ui_win_mode = edges ? 2 : 1;
+        if (edges)
+            ui_snapped = 0;             /* resizing by an edge ends a snap */
+        ui_win_moved = 0;
+        ui_win_edges = edges;
+        ui_gx0 = gx;
+        ui_gy0 = gy;
+        SDL_GetWindowPosition(window, &ui_wx0, &ui_wy0);
+        SDL_GetWindowSize(window, &ui_ww0, &ui_wh0);
+        SDL_CaptureMouse(SDL_TRUE);
+        /* Edge clicks are ours. A click on the picture also goes on to the
+           double-click-for-fullscreen code. */
+        return edges != 0;
+    }
+    if (ev->type == SDL_MOUSEMOTION) {
+        if (ui_win_mode == 1) {
+            /* Ignore tiny movements so a double-click doesn't nudge the window */
+            if (!ui_win_moved && FFABS(gx - ui_gx0) < 4 && FFABS(gy - ui_gy0) < 4)
+                return 1;
+            if (!ui_win_moved && ui_snapped)
+                ui_unsnap(gx, gy);      /* dragging a snapped window gives it its old size back */
+            ui_win_moved = 1;
+            SDL_SetWindowPosition(window, ui_wx0 + gx - ui_gx0, ui_wy0 + gy - ui_gy0);
+            ui_snap_zone = ui_snap_zone_at(gx, gy);
+            if (is)
+                is->force_refresh = 1;
+            ui_wake();
+            return 1;
+        }
+        if (ui_win_mode == 2) {
+            ui_resize_to(is, gx, gy);
+            ui_wake();
+            return 1;
+        }
+        /* Not dragging: show a resize cursor over the edges */
+        ui_set_cursor(ui_edges_at(ev->motion.x, ev->motion.y));
+        return 0;
+    }
+    if (ev->type == SDL_MOUSEBUTTONUP && ev->button.button == SDL_BUTTON_LEFT && ui_win_mode) {
+        if (ui_win_mode == 1 && ui_snap_zone) {
+            ui_snap_apply(ui_snap_zone);        /* let go at a screen edge: snap */
+            if (is)
+                is->force_refresh = 1;
+        }
+        ui_snap_zone = 0;
+        was_resize = (ui_win_mode == 2);
+        ui_win_mode = 0;
+        SDL_CaptureMouse(SDL_FALSE);
+        return was_resize;
+    }
+    return 0;
+}
+
+/* The idle screen: logo and menu. Returns when something has been added to the queue. */
+static void ui_idle_loop(void)
+{
+    SDL_Event ev;
+
+    if (!window)
+        do_exit(NULL);              /* no window to show (-nodisp) */
+
+    /* The window starts hidden, so show it. Keep its size if it was already open. */
+    if (!SDL_GetWindowFlags(window) || !(SDL_GetWindowFlags(window) & SDL_WINDOW_SHOWN)) {
+        SDL_SetWindowTitle(window, "ffplay-custom");
+        if (!is_full_screen)
+            SDL_SetWindowSize(window, 960, 540);
+        SDL_ShowWindow(window);
+        if (is_full_screen)
+            SDL_SetWindowFullscreen(window, SDL_WINDOW_FULLSCREEN_DESKTOP);
+    }
+    if (cursor_hidden) {
+        SDL_ShowCursor(1);
+        cursor_hidden = 0;
+    }
+    ui_idle = 1;
+    ui_menu_open = 0;
+    ui_menu_hover = -1;
+    ui_q_open = 0;
+    ui_info_open = 0;
+    ui_open_open = 0;
+    ui_ctx_open = 0;
+    ui_q_drag = -1;
+
+    /* wait here until there is something to play (after a sleep stop: until the user picks something) */
+    while (queue_next() >= q_count || (q_hold && q_forced < 0)) {
+        ui_inbox_tick(NULL);
+        ui_power_tick(NULL);
+        ui_sleep_tick(NULL);
+        ui_mpris_tick(NULL);
+        ui_q_autoscroll();
+        while (SDL_PollEvent(&ev)) {
+            switch (ev.type) {
+            case SDL_QUIT:
+                do_exit(NULL);
+                break;
+            case SDL_KEYDOWN:
+                ev.key.keysym.sym = ui_key_translate(ev.key.keysym.sym);   /* the keys chosen in settings.conf */
+                if (ui_prefs_open && ev.key.keysym.sym == SDLK_ESCAPE)
+                    ui_prefs_open = 0;
+                else if (ev.key.keysym.sym == SDLK_q || ev.key.keysym.sym == SDLK_ESCAPE)
+                    do_exit(NULL);
+                else if (ev.key.keysym.sym == SDLK_f)
+                    toggle_full_screen(NULL);
+                break;
+            case SDL_WINDOWEVENT:
+                if (ev.window.event == SDL_WINDOWEVENT_SIZE_CHANGED) {
+                    screen_width  = ev.window.data1;    /* the next video opens at this size */
+                    screen_height = ev.window.data2;
+                }
+                break;
+            case SDL_MOUSEWHEEL:
+                ui_queue_wheel(&ev);
+                break;
+            case SDL_MOUSEBUTTONDOWN:
+            case SDL_MOUSEMOTION:
+            case SDL_MOUSEBUTTONUP:
+                if (ev.type == SDL_MOUSEBUTTONUP && ui_queue_release(&ev))
+                    break;
+                if (ev.type != SDL_MOUSEBUTTONUP && ui_menu_mouse(NULL, &ev))
+                    break;
+                ui_window_mouse(NULL, &ev);     /* drag to move, edges to resize */
+                break;
+            default:
+                break;
+            }
+        }
+        ui_glass_frame(NULL);
+        SDL_Delay(16);
+    }
+    q_hold = 0;
+    ui_idle = 0;
+}
+
+/* Seek by incr seconds: the same as the Left and Right arrow keys */
+static void ui_seek_relative(VideoState *is, double incr)
+{
+    double pos;
+
+    if (seek_by_bytes) {
+        pos = -1;
+        if (pos < 0 && is->video_stream >= 0)
+            pos = frame_queue_last_pos(&is->pictq);
+        if (pos < 0 && is->audio_stream >= 0)
+            pos = frame_queue_last_pos(&is->sampq);
+        if (pos < 0)
+            pos = avio_tell(is->ic->pb);
+        if (is->ic->bit_rate)
+            incr *= is->ic->bit_rate / 8.0;
+        else
+            incr *= 180000.0;
+        pos += incr;
+        stream_seek(is, pos, incr, 1);
+    } else {
+        pos = get_master_clock(is);
+        if (isnan(pos))
+            pos = (double)is->seek_pos / AV_TIME_BASE;
+        pos += incr;
+        if (is->ic->start_time != AV_NOPTS_VALUE && pos < is->ic->start_time / (double)AV_TIME_BASE)
+            pos = is->ic->start_time / (double)AV_TIME_BASE;
+        stream_seek(is, (int64_t)(pos * AV_TIME_BASE), (int64_t)(incr * AV_TIME_BASE), 0);
+    }
+}
+
+/* The mouse wheel (or a touchpad swipe), as chosen in Preferences: volume, seek, or nothing */
+static void ui_wheel_action(VideoState *is, SDL_Event *ev)
+{
+    static double acc = 0.0;
+    static int64_t last = 0;
+    int64_t now = av_gettime_relative();
+    double amount;
+    int steps, i;
+
+    if (!cfg_wheel || ui_menu_open || ui_prefs_open)
+        return;
+    {
+        double ax, ay;
+#if SDL_VERSION_ATLEAST(2, 0, 18)
+        ax = ev->wheel.preciseX;
+        ay = ev->wheel.preciseY;
+#else
+        ax = ev->wheel.x;
+        ay = ev->wheel.y;
+#endif
+        if (FFABS(ax) > FFABS(ay)) {            /* a sideways swipe moves through the queue */
+            ui_flow_swipe(is, ev);
+            return;
+        }
+    }
+#if SDL_VERSION_ATLEAST(2, 0, 18)
+    amount = ev->wheel.preciseY;
+#else
+    amount = ev->wheel.y;
+#endif
+    if (ev->wheel.direction == SDL_MOUSEWHEEL_FLIPPED)
+        amount = -amount;
+    if (now - last > 300000 || amount * acc < 0.0)
+        acc = 0.0;                              /* a new swipe, or the other direction: start from zero */
+    last = now;
+    acc += amount;
+    steps = (int)acc;                           /* whole notches only: a touchpad adds up small moves */
+    if (!steps)
+        return;
+    acc -= steps;
+    if (cfg_wheel == 1) {
+        for (i = 0; i < FFABS(steps); i++)
+            update_volume(is, steps > 0 ? -1 : 1, SDL_VOLUME_STEP);        /* reversed */
+    } else {
+        ui_seek_relative(is, steps * cfg_seek);
+    }
+    ui_wake();                                  /* the bars show what happened */
+    is->force_refresh = 1;
+}
