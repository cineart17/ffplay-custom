+/* End the file that is playing. The main loop then goes on with whatever queue_next() says. */
+static void ui_end_current(VideoState *is)
+{
+    SDL_Event e;
+
+    if (!is)
+        return;
+    ui_user_skip = 1;
+    SDL_zero(e);
+    e.type = FF_QUIT_EVENT;
+    e.user.data1 = is;
+    SDL_PushEvent(&e);
+}
