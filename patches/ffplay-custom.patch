+static void ui_pk_size_str(int64_t n, char *out, size_t size)
+{
+    double sz = (double)n;
+
+    if (sz < 1000.0)
+        snprintf(out, size, "%d bytes", (int)sz);
+    else if (sz < 1e6)
+        snprintf(out, size, "%.1f kB", sz / 1e3);
+    else if (sz < 1e9)
+        snprintf(out, size, "%.1f MB", sz / 1e6);
+    else
+        snprintf(out, size, "%.1f GB", sz / 1e9);
+}
