+/* ----- frosted glass ----- */
+static SDL_Texture *ui_scene_tex = NULL;    /* the finished picture, so it can be blurred */
+static SDL_Texture *ui_blur_tex[4];         /* the picture at 1/2, 1/4, 1/8 and 1/16 size */
