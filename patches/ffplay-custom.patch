+/* ---- names and matching ---- */
+static int ui_tv_lc(int c);
+
+/* v39: words that say nothing about the song, when they are all there is inside brackets: (Official Music Video), [1080P HD] ... */
+static int ui_tv_noise_tok(const char *t)
+{
+    static const char * const w[] = { "official", "music", "video", "videos", "audio", "lyric", "lyrics", "lyrical", "visualizer",
+                                      "visualiser", "hd", "hq", "uhd", "fhd", "mv", "explicit", "full", "hdr", "remastered",
+                                      "remaster", "h264", "h265", "hevc", "x264", "x265", "av1", "vp9", "aac", "mp3", "opus", NULL };
+    int i, n = 0;
+
+    for (i = 0; w[i]; i++)
+        if (!strcmp(t, w[i]))
+            return 1;
+    while (t[n] >= '0' && t[n] <= '9')
+        n++;
+    if (n > 0 && t[n]) {                        /* 1080p, 60fps, 4k, 128kbit, 44khz */
+        const char *u = t + n;
+
+        return !strcmp(u, "p") || !strcmp(u, "fps") || !strcmp(u, "k") || !strcmp(u, "kbit") || !strcmp(u, "kbps") ||
+               !strcmp(u, "hz") || !strcmp(u, "khz") || !strcmp(u, "bit");
+    }
+    return 0;
+}
+
+static int ui_tv_word_c(int c)
+{
+    return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c >= 0x80;
+}
+
+static int ui_tv_noise_group(const char *s, int n)
+{
+    char tok[32];
+    int i = 0, k, words = 0;
+
+    while (i < n) {
+        while (i < n && !ui_tv_word_c((unsigned char)s[i]))
+            i++;
+        if (i >= n)
+            break;
+        k = 0;
+        while (i < n && ui_tv_word_c((unsigned char)s[i])) {
+            if (k < 30)
+                tok[k++] = (char)ui_tv_lc((unsigned char)s[i]);
+            i++;
+        }
+        tok[k] = 0;
+        if (!ui_tv_noise_tok(tok))
+            return 0;
+        words++;
+    }
+    return words > 0;
+}
+
+static void ui_tv_clean(char *s)
+{
+    static const char * const tail[] = { "official music video", "official lyric video", "official video", "official audio",
+                                         "official visualizer", "music video", "lyric video", "lyrics video", NULL };
+    char o[512];
+    int n = (int)strlen(s), i = 0, k = 0, j, again;
+
+    if (n <= 0 || n >= (int)sizeof(o) - 2)
+        return;
+    for (j = 3; j + 3 <= n; j++) {              /* a telephone company's promo at the end: "SMS 'SKIZA 123' to 811", "To subscribe to skiza..." */
+        if (s[j - 1] != ' ')
+            continue;
+        if ((!av_strncasecmp(s + j, "sms", 3) && (j + 3 == n || s[j + 3] == ' ' || s[j + 3] == '\'' || s[j + 3] == '[')) ||
+            !av_strncasecmp(s + j, "to subcribe", 11) || !av_strncasecmp(s + j, "to subscribe", 12)) {
+            n = j;
+            s[n] = 0;
+            break;
+        }
+    }
+    while (i < n) {
+        char c = s[i];
+
+        if (c == '(' || c == '[' || c == '{') {
+            char close = c == '(' ? ')' : c == '[' ? ']' : '}';
+
+            j = i + 1;
+            while (j < n && s[j] != close)
+                j++;
+            if (j < n && ui_tv_noise_group(s + i + 1, j - i - 1)) {         /* the group goes, with the space before it */
+                while (k > 0 && o[k - 1] == ' ')
+                    k--;
+                i = j + 1;
+                while (i < n && s[i] == ' ')
+                    i++;
+                if (k > 0 && i < n)
+                    o[k++] = ' ';
+                continue;
+            }
+        }
+        o[k++] = s[i++];
+    }
+    o[k] = 0;
+    do {                                        /* the same words without brackets, at the end of the title */
+        again = 0;
+        while (k > 0 && (o[k - 1] == ' ' || o[k - 1] == '-' || o[k - 1] == '|' || o[k - 1] == '~' || o[k - 1] == ':' || o[k - 1] == '_'))
+            o[--k] = 0;
+        for (i = 0; tail[i]; i++) {
+            int tl = (int)strlen(tail[i]), p = k - tl, q;
+
+            if (p < 1 || (o[p - 1] != ' ' && o[p - 1] != '-'))
+                continue;
+            for (q = 0; q < tl && ui_tv_lc((unsigned char)o[p + q]) == tail[i][q]; q++)
+                ;
+            if (q == tl) {
+                k = p;
+                o[k] = 0;
+                again = 1;
+                break;
+            }
+        }
+    } while (again);
+    while (k > 0 && (o[k - 1] == ' ' || o[k - 1] == '-' || o[k - 1] == '|' || o[k - 1] == '~' || o[k - 1] == ':' || o[k - 1] == '_'))
+        o[--k] = 0;
+    if (k > 0)
+        memcpy(s, o, k + 1);
+}
+
+static void ui_tv_name(const char *s, char *out, size_t size)
+{
+    const char *slash = strrchr(s, '/');
+    char *dot, *open, keep[320];
+    size_t len;
+
+    snprintf(out, size, "%s", slash ? slash + 1 : s);
+    dot = strrchr(out, '.');
+    if (dot && dot != out && strlen(dot) <= 5)
+        *dot = 0;
+    for (;;) {
+        len = strlen(out);
+        while (len > 0 && out[len - 1] == ' ')
+            out[--len] = 0;
+        open = strrchr(out, '(');
+        if (!open || open == out || len == 0 || out[len - 1] != ')' || !ui_q_is_codec_info(open + 1))
+            break;
+        *open = 0;
+    }
+    snprintf(keep, sizeof(keep), "%s", out);
+    ui_tv_clean(out);
+    if (!out[0])
+        snprintf(out, size, "%s", keep);
+}
+
+static int ui_tv_lc(int c)
+{
+    return (c >= 'A' && c <= 'Z') ? c + 32 : c;
+}
+
+/* How well a title fits what was typed. 0 = it does not. hl[] gets 1 for every byte of the title that matches (whole UTF-8
+   letters). Every word typed is looked for as it is (best where a word starts), else its letters in order. */
+static int ui_tv_match(const char *name, const char *query, unsigned char *hl)
+{
+    char ln[UI_TV_HL];
+    int n = (int)strlen(name), score = 0, matched = 0, total = 0, words = 0, i;
+    const char *q = query;
+
+    if (n > UI_TV_HL - 1)
+        n = UI_TV_HL - 1;
+    for (i = 0; i < n; i++)
+        ln[i] = (char)ui_tv_lc((unsigned char)name[i]);
+    memset(hl, 0, UI_TV_HL);
+    while (*q) {
+        char w[96];
+        int m = 0, best = -1, bests = -1, p, k, cur;
+
+        while (*q == ' ')
+            q++;
+        while (*q && *q != ' ' && m < (int)sizeof(w) - 1)
+            w[m++] = (char)ui_tv_lc((unsigned char)*q++);
+        w[m] = 0;
+        if (!m)
+            break;
+        words++;
+        total += m;
+        for (p = 0; p + m <= n; p++) {          /* the word as it is: the best place for it */
+            int s;
+
+            if (memcmp(ln + p, w, m))
+                continue;
+            s = 10 + (p == 0 ? 6 : 0) + ((p > 0 && (ln[p - 1] == ' ' || ln[p - 1] == '-' || ln[p - 1] == '_' || ln[p - 1] == '.')) ? 5 : 0);
+            if (s > bests) {
+                bests = s;
+                best = p;
+            }
+        }
+        if (best >= 0) {
+            for (k = 0; k < m; k++)
+                hl[best + k] = 1;
+            matched += m;
+            score += m * 12 + bests * 3;
+            continue;
+        }
+        cur = 0;                                /* else its letters in order */
+        for (k = 0; k < m; k++) {
+            for (p = cur; p < n; p++) {
+                if (((unsigned char)ln[p] & 0xC0) == 0x80 || ln[p] != w[k])
+                    continue;
+                break;
+            }
+            if (p >= n)
+                continue;                       /* this letter is not there: the word only matches in part */
+            score += 4 - FFMIN(p - cur, 3);
+            matched++;
+            hl[p] = 1;
+            p++;
+            while (p < n && ((unsigned char)ln[p] & 0xC0) == 0x80)
+                hl[p++] = 1;
+            cur = p;
+        }
+    }
+    if (!words || matched == 0)
+        return 0;
+    if (total <= 2 ? matched < total : matched * 100 < 70 * total)
+        return 0;
+    score -= (total - matched) * 6;
+    score -= n / 10;
+    return score > 0 ? score : 1;
+}
+
+static void ui_tv_sec_free(UiTvSec *sec)
+{
+    int i;
+
+    for (i = 0; i < sec->n; i++)
+        av_freep(&sec->h[i].path);
+    sec->n = 0;
+}
+
+static void ui_tv_offer(UiTvSec *sec, const char *path, int score, const unsigned char *hl)
+{
+    UiTvHit *h;
+    int i, mi = 0;
+
+    if (!sec->h)
+        sec->h = av_calloc(UI_TV_KEEP, sizeof(UiTvHit));
+    if (!sec->h)
+        return;
+    if (sec->n < UI_TV_KEEP) {
+        h = &sec->h[sec->n];
+    } else {
+        for (i = 1; i < sec->n; i++)
+            if (sec->h[i].score < sec->h[mi].score)
+                mi = i;
+        if (sec->h[mi].score >= score)
+            return;
+        h = &sec->h[mi];
+        av_freep(&h->path);
+    }
+    h->path = av_strdup(path);
+    if (!h->path)
+        return;
+    h->score = score;
+    memcpy(h->hl, hl, UI_TV_HL);
+    if (h == &sec->h[sec->n])
+        sec->n++;
+    else if (!h->path)
+        h->score = 0;
+}
+
+static int ui_tv_cmp(const void *a, const void *b)
+{
+    const UiTvHit *x = a, *y = b;
+
+    return y->score - x->score;
+}
+
+static void ui_tv_search(void)
+{
+    int64_t now = av_gettime_relative();
+    char nm[300];
+    unsigned char hl[UI_TV_HL];
+    int s, i, k, sc;
+
+    for (s = 0; s < 3; s++) {
+        ui_tv_sec_free(&ui_tv_sec[s]);
+        ui_tv_sec[s].pos = 0.0;                 /* the best match is the one in focus, the others come after it */
+        ui_tv_sec[s].target = 0;
+        ui_tv_sec[s].born = now;                /* and the tiles spring in */
+    }
+    ui_tv_act = 0;
+    if (!ui_tv_q[0])
+        return;
+    ui_tv_scan_start();
+    for (i = 0; i < q_count; i++) {
+        ui_tv_name(q_items[i], nm, sizeof(nm));
+        sc = ui_tv_match(nm, ui_tv_q, hl);
+        if (sc > 0)
+            ui_tv_offer(&ui_tv_sec[0], q_items[i], sc, hl);
+    }
+    if (ui_tv_mu) {
+        SDL_LockMutex(ui_tv_mu);
+        for (k = 0; k < 2; k++)
+            for (i = 0; i < ui_tv_lib[k].n; i++) {
+                ui_tv_name(ui_tv_lib[k].p[i], nm, sizeof(nm));
+                sc = ui_tv_match(nm, ui_tv_q, hl);
+                if (sc > 0)
+                    ui_tv_offer(&ui_tv_sec[1 + k], ui_tv_lib[k].p[i], sc, hl);
+            }
+        SDL_UnlockMutex(ui_tv_mu);
+    }
+    for (s = 0; s < 3; s++)
+        if (ui_tv_sec[s].n > 1)
+            qsort(ui_tv_sec[s].h, ui_tv_sec[s].n, sizeof(UiTvHit), ui_tv_cmp);
+    for (s = 2; s >= 0; s--)
+        if (ui_tv_sec[s].n > 0)
+            ui_tv_act = s;                      /* the keys start in the first section that has something */
+}
+
+/* ---- when is the view there, and does it own the keys? ---- */
+static int ui_tv_on(VideoState *is)
+{
+    if (!is || q_count <= 0 || q_pos < 0 || q_pos >= q_count)
+        return 0;
+    if (ui_tv_audio && (!ui_flow_on(is) || ui_flow_video(is)))
+        ui_tv_audio = 0;
+    return ui_flow_video(is) || ui_tv_audio;
+}
+
+static int ui_tv_cap(VideoState *is)
+{
+    if (!ui_tv_on(is))
+        return 0;
+    if (ui_flow_video(is))
+        return ui_vflow && !ui_vflow_auto;      /* a pause that opened the view by itself leaves the keys alone */
+    return 1;
+}
+
+static void ui_tv_dims(VideoState *is, int *R, int *L)
+{
+    int n = q_count;
+
+    *R = n <= 3 ? 1 : (is->height >= 720 ? 3 : 2);
+    *L = FFMAX((n + *R - 1) / *R, 1);
+}
+
+static void ui_tv_reset(VideoState *is, int64_t now)
+{
+    int R, L, s;
+
+    ui_tv_q[0] = 0;
+    ui_tv_searching = 0;
+    for (s = 0; s < 3; s++)
+        ui_tv_sec_free(&ui_tv_sec[s]);
+    ui_tv_focus = av_clip(q_pos, 0, q_count - 1);
+    ui_tv_dims(is, &R, &L);
+    ui_tv_pos = ui_tv_focus % L;
+    ui_tv_row = ui_tv_focus / L;
+    ui_tv_born = now;
+    ui_tv_press = -1;
+    ui_tv_drag = 0;
+    ui_tvc_open = 0;
+    ui_pv_request(NULL);
+}
+
+static void ui_tv_enter(VideoState *is)
+{
+    if (!is || q_count <= 0 || q_pos < 0 || ui_tv_cap(is) || ui_too_small())
+        return;
+    if (is->video_st && !(is->video_st->disposition & AV_DISPOSITION_ATTACHED_PIC)) {
+        if (!ui_vflow) {                        /* the same start as key L */
+            ui_vflow = 1;
+            ui_vflow_t = 0;
+            ui_bd_key[0] = 0;
+            ui_flow_pos = ui_flow_target = q_pos;
+            ui_flow_last_q = q_pos;
+            ui_flow_touch = 0;
+        }
+        ui_vflow_auto = 0;
+    } else if (is->audio_st) {
+        ui_tv_audio = 1;
+    }
+    ui_tv_seen = 0;                             /* the view starts from the playing item */
+    SDL_StartTextInput();
+    is->force_refresh = 1;
+}
+
+static void ui_tv_exit(VideoState *is)
+{
+    int s;
+
+    ui_tv_q[0] = 0;
+    ui_tv_searching = 0;
+    for (s = 0; s < 3; s++)
+        ui_tv_sec_free(&ui_tv_sec[s]);
+    ui_tvc_open = 0;
+    ui_pv_request(NULL);
+    if (ui_flow_video(is) && ui_vflow) {
+        ui_vflow_auto = 0;
+        ui_vflow_set(is, 0);                    /* the video grows back */
+    }
+    ui_tv_audio = 0;
+    is->force_refresh = 1;
+}
+
+/* Play a file from the view: one that is in the queue is played from there, one from a folder is added first */
+static void ui_tv_play(VideoState *is, const char *path)
+{
+    int i, idx = -1;
+
+    if (!path)
+        return;
+    for (i = 0; i < q_count && idx < 0; i++)
+        if (!strcmp(q_items[i], path))
+            idx = i;
+    if (idx < 0) {                              /* the same file under another name (a relative path in the queue, a full one here) */
+        char *rp = realpath(path, NULL);
+
+        for (i = 0; rp && i < q_count && idx < 0; i++) {
+            char *rq = realpath(q_items[i], NULL);
+
+            if (rq && !strcmp(rq, rp))
+                idx = i;
+            free(rq);
+        }
+        free(rp);
+    }
+    if (idx >= 0 && idx == q_pos) {             /* the one that plays: back to it */
+        if (ui_flow_video(is))
+            ui_tile_open(is);
+        else if (is->paused)
+            toggle_pause(is);
+        ui_tv_exit(is);
+        return;
+    }
+    if (idx < 0) {
+        queue_add(path);
+        idx = q_count - 1;
+    }
+    ui_tv_exit(is);
+    q_forced = idx;
+    ui_end_current(is);
+}
+
+static const char *ui_tv_sel_path(void)
+{
+    UiTvSec *sec = &ui_tv_sec[ui_tv_act];
+
+    return (sec->n > 0 && sec->target >= 0 && sec->target < sec->n) ? sec->h[sec->target].path : NULL;
+}
+
+static void ui_tv_step(VideoState *is, int dcol, int drow)
+{
+    ui_tv_moving = 1;
+    if (ui_tv_q[0]) {                           /* searching: along a section, or to the next section that has something */
+        UiTvSec *sec = &ui_tv_sec[ui_tv_act];
+        int s;
+
+        if (dcol && sec->n > 0)
+            sec->target = av_clip(sec->target + dcol, 0, sec->n - 1);
+        for (s = ui_tv_act + drow; drow && s >= 0 && s < 3; s += drow)
+            if (ui_tv_sec[s].n > 0) {
+                ui_tv_act = s;
+                break;
+            }
+    } else {                                    /* browsing: the row ends where it ends, up and down keep the column */
+        int R, L, row, col;
+
+        ui_tv_dims(is, &R, &L);
+        row = ui_tv_focus / L;
+        col = ui_tv_focus % L;
+        if (dcol)
+            col = av_clip(col + dcol, 0, L - 1);
+        if (drow)
+            row = av_clip(row + drow, 0, R - 1);
+        ui_tv_focus = av_clip(row * L + col, 0, q_count - 1);
+    }
+    is->force_refresh = 1;
+}
+
+static int ui_tv_key(VideoState *is, SDL_Event *ev)
+{
+    SDL_Keycode k = ev->key.keysym.sym;
+    const char *p;
+
+    if (!ui_tv_cap(is) || ui_menu_open || ui_prefs_open || ui_q_open || ui_info_open || ui_open_open || ui_ctx_open)
+        return 0;
+    if ((ev->key.keysym.mod & (KMOD_CTRL | KMOD_ALT | KMOD_GUI)) || (k >= SDLK_F1 && k <= SDLK_F12))
+        return 0;
+    ui_wake();
+    if (ui_tvc_open) {                          /* v39: the menu of a tile: any key closes it, Esc is used up by that */
+        ui_tvc_open = 0;
+        if (k == SDLK_ESCAPE)
+            return 1;
+    }
+    switch (k) {
+    case SDLK_ESCAPE:                           /* Esc closes the search, Esc again closes the view */
+        if (ui_tv_q[0] || ui_tv_searching) {
+            ui_tv_q[0] = 0;
+            ui_tv_searching = 0;
+            ui_tv_search();
+            ui_tv_moving = 1;
+        } else {
+            ui_tv_exit(is);
+        }
+        return 1;
+    case SDLK_TAB:
+        ui_tv_exit(is);
+        return 1;
+    case SDLK_RETURN:
+    case SDLK_KP_ENTER:
+        p = ui_tv_q[0] ? ui_tv_sel_path() : q_items[av_clip(ui_tv_focus, 0, q_count - 1)];
+        ui_tv_play(is, p);
+        return 1;
+    case SDLK_BACKSPACE: {
+        size_t n = strlen(ui_tv_q);
+
+        if (n > 0) {
+            do
+                n--;
+            while (n > 0 && ((unsigned char)ui_tv_q[n] & 0xC0) == 0x80);
+            ui_tv_q[n] = 0;
+            ui_tv_search();
+            ui_tv_moving = 1;
+        }
+        return 1;
+    }
+    case SDLK_LEFT:
+        ui_tv_step(is, -1, 0);
+        return 1;
+    case SDLK_RIGHT:
+        ui_tv_step(is, 1, 0);
+        return 1;
+    case SDLK_UP:
+        ui_tv_step(is, 0, -1);
+        return 1;
+    case SDLK_DOWN:
+        ui_tv_step(is, 0, 1);
+        return 1;
+    case SDLK_HOME:
+        ui_tv_step(is, -100000, 0);
+        return 1;
+    case SDLK_END:
+        ui_tv_step(is, 100000, 0);
+        return 1;
+    case SDLK_SPACE:
+        if (!ui_tv_q[0])
+            toggle_pause(is);                   /* nothing typed: Space still pauses */
+        return 1;
+    default:
+        return 1;                               /* the letters belong to the search (they arrive as text) */
+    }
+}
+
+static int ui_tv_text(VideoState *is, const char *t)
+{
+    size_t n = strlen(ui_tv_q), m = strlen(t);
+
+    if (!ui_tv_cap(is) || ui_menu_open || ui_prefs_open || ui_q_open || ui_info_open || ui_open_open || ui_ctx_open)
+        return 0;
+    if (!n && t[0] == ' ')
+        return 1;
+    if (n + m >= sizeof(ui_tv_q) - 1)
+        return 1;
+    memcpy(ui_tv_q + n, t, m + 1);
+    ui_tv_searching = 1;
+    ui_tv_search();
+    ui_tv_moving = 1;
+    return 1;
+}
+
+/* Swipes (v38). ui_wheel_action decides who gets a swipe (the Scroll action preference, and the bars); these are the parts that
+   belong to the tiled view. ay is already turned the right way round: a negative ay is fingers moving up. */
+static int64_t ui_tv_gest_until = 0;            /* the end of the swipe that opened the view keeps coming for a moment: it moves nothing */
+
+static int ui_tv_sec_at(int y)                  /* the section (while searching) that has the height y, or -1 */
+{
+    int s;
+
+    for (s = 0; s < 3; s++)
+        if (y >= ui_tv_secy[s][0] && y < ui_tv_secy[s][1])
+            return s;
+    return -1;
+}
+
+/* Sideways: browsing, every row moves together. Searching, the section the mouse is resting on moves, on its own. */
+static void ui_tv_swipe_x(VideoState *is, double ax)
+{
+    static double acc = 0.0;
+    static int64_t last = 0;
+    int64_t now = av_gettime_relative();
+    int steps;
+
+    if (now - last > 300000 || ax * acc < 0.0)
+        acc = 0.0;
+    last = now;
+    acc += ax;
+    steps = (int)acc;
+    if (!steps)
+        return;
+    acc -= steps;
+    if (ui_tv_q[0]) {
+        int mx, my, s;
+
+        SDL_GetMouseState(&mx, &my);
+        s = ui_tv_sec_at(my);
+        if (s >= 0 && ui_tv_sec[s].n > 0)
+            ui_tv_act = s;
+    }
+    ui_tv_step(is, steps, 0);
+}
+
+/* Fingers down: the view closes (animated, like Esc). Up and down no longer move tiles: the arrow keys do. */
+static void ui_tv_swipe_y(VideoState *is, double ay)
+{
+    static double acc = 0.0;
+    static int64_t last = 0;
+    static int lock = 0;
+    int64_t now = av_gettime_relative();
+
+    if (now < ui_tv_gest_until)
+        return;
+    if (now - last > 250000) {
+        acc = 0.0;
+        lock = 0;
+    }
+    last = now;
+    acc += ay;
+    if (!lock && acc * UI_TV_UP_SIGN <= -1.2) {
+        lock = 1;
+        ui_tv_gest_until = now + 700000;
+        ui_tv_exit(is);
+        is->force_refresh = 1;
+    }
+}
+
+/* Fingers up (the Navigation choice) with the view closed: it opens. Returns 1 if the swipe was up. */
+static int ui_tv_swipe_open(VideoState *is, double ay)
+{
+    static double acc = 0.0;
+    static int64_t last = 0;
+    int64_t now = av_gettime_relative();
+
+    if (ay * UI_TV_UP_SIGN <= 0.0)
+        return 0;                               /* down: nothing to do while the view is closed */
+    if (now - last > 250000)
+        acc = 0.0;
+    last = now;
+    acc += FFABS(ay);
+    if (now >= ui_tv_gest_until && acc >= 1.0) {
+        acc = 0.0;
+        ui_tv_gest_until = now + 700000;
+        ui_tv_enter(is);
+    }
+    return 1;
+}
+
+/* ---- drawing ---- */
+static void ui_tv_theme(int *r, int *g, int *b)
+{
+    *r = FFMIN(255, cfg_bar_r + 55);
+    *g = FFMIN(255, cfg_bar_g + 55);
+    *b = FFMIN(255, cfg_bar_b + 55);
+}
+
+/* A soft glow in the bar color behind a tile: a fan that is strongest in the middle and nothing at the rim */
+static void ui_tv_glow(double cx, double cy, double rx, double ry, int a)
+{
+    enum { N = 36 };
+    SDL_Vertex v[N + 2];
+    int idx[N * 3], k, r, g, b;
+
+    if (a <= 2)
+        return;
+    r = cfg_bar_r;
+    g = cfg_bar_g;
+    b = cfg_bar_b;
+    v[0].position.x = (float)cx;
+    v[0].position.y = (float)cy;
+    v[0].color.r = (Uint8)r;
+    v[0].color.g = (Uint8)g;
+    v[0].color.b = (Uint8)b;
+    v[0].color.a = (Uint8)av_clip(a, 0, 255);
+    v[0].tex_coord.x = v[0].tex_coord.y = 0.0f;
+    for (k = 0; k <= N; k++) {
+        double an = k * 6.28318530718 / N;
+
+        v[k + 1].position.x = (float)(cx + cos(an) * rx);
+        v[k + 1].position.y = (float)(cy + sin(an) * ry);
+        v[k + 1].color = v[0].color;
+        v[k + 1].color.a = 0;
+        v[k + 1].tex_coord.x = v[k + 1].tex_coord.y = 0.0f;
+    }
+    for (k = 0; k < N; k++) {
+        idx[k * 3] = 0;
+        idx[k * 3 + 1] = k + 1;
+        idx[k * 3 + 2] = k + 2;
+    }
+    SDL_RenderGeometry(renderer, NULL, v, N + 2, idx, N * 3);
+}
+
+/* A title with the matched letters in the bar color. It is cut with "..." to fit max_w (the letters that are kept keep their color). */
+static void ui_tv_label(const char *name, const unsigned char *hl, int px, int cx, int cy, int max_w, int a)
+{
+    char s[320], pre[320];
+    unsigned char h[320];
+    int n = (int)strlen(name), lo, hi, i, j, x0, tr, tg, tb;
+
+    if (n > 300)
+        n = 300;
+    memcpy(s, name, n);
+    s[n] = 0;
+    memset(h, 0, sizeof(h));
+    if (hl)
+        memcpy(h, hl, FFMIN(n, UI_TV_HL));
+    if (ui_text_width(s, px) > max_w) {         /* binary search for how much fits with the dots */
+        lo = 0;
+        hi = n;
+        while (lo < hi) {
+            int mid = (lo + hi + 1) / 2, keep = mid;
+
+            while (keep > 0 && ((unsigned char)s[keep] & 0xC0) == 0x80)
+                keep--;
+            memcpy(pre, s, keep);
+            memcpy(pre + keep, "...", 4);
+            if (ui_text_width(pre, px) <= max_w)
+                lo = mid;
+            else
+                hi = mid - 1;
+        }
+        while (lo > 0 && ((unsigned char)s[lo] & 0xC0) == 0x80)
+            lo--;
+        memcpy(s + lo, "...", 4);
+        for (i = lo; i < lo + 3; i++)
+            h[i] = 0;
+        n = lo + 3;
+    }
+    ui_tv_theme(&tr, &tg, &tb);
+    x0 = cx - ui_text_width(s, px) / 2;
+    for (i = 0; i < n; i = j) {
+        char seg[320];
+        int xo = 0;
+
+        for (j = i; j < n && h[j] == h[i]; j++)
+            ;
+        memcpy(seg, s + i, j - i);
+        seg[j - i] = 0;
+        if (i > 0) {
+            memcpy(pre, s, i);
+            pre[i] = 0;
+            xo = ui_text_width(pre, px);
+        }
+        if (h[i])
+            ui_label(x0 + xo, cy, seg, px, tr, tg, tb, a);
+        else
+            ui_label(x0 + xo, cy, seg, px, 255, 255, 255, a * 70 / 100);
+    }
+}
+
+/* The tile of a file (a picture of its own shape, or the file icon), flat with rounded corners and a soft shadow */
+static void ui_tv_tile(const char *path, const SDL_Rect *t, int al, int md)
+{
+    SDL_Texture *tex;
+    int cw = 0, ch = 0;
+
+    tex = ui_cov_native(path, &cw, &ch);
+    if (!tex)
+        tex = ui_cov_get(path, &cw, &ch);
+    if (tex)                                    /* v47: the shadow has the same rounded corners as the tile */
+        ui_tile_shadow(tex, t, al, 0.0, FFMIN(t->w, t->h) / 11);
+    else
+        tex = ui_flow_icon();
+    if (tex)
+        ui_flow_quad_round(tex, t, al, md, 0.0, FFMIN(t->w, t->h) / 11);
+}
+
+/* ---- v39: a video tile plays (picture only, at the video's own rate) while the mouse rests on it ----
+   One thread decodes the one file that is wanted, scales it to at most 512 px and hands the newest picture over. Nothing else is
+   decoded, so it stays light. It stops by itself when the view has not asked for a picture for 2 seconds. */
+#define UI_PV_SIDE 512
+
+typedef struct {
+    SDL_Thread *th;
+    SDL_mutex *mu;
+    SDL_cond *cv;
+    volatile int quit;
+    volatile int gen;                           /* changes with every new request */
+    char want[4096];                            /* the file that is wanted ("" = none) */
+    char dead[4096];                            /* a file that could not be played: it is not tried again at once */
+    uint8_t *pix;                               /* the newest picture (RGBA) */
+    int w, h, fresh, cgen;                      /* its size; 1 = not yet in the texture; the request it belongs to */
+    int64_t last_get;                           /* when the view last asked for it */
+    SDL_Texture *tex;
+    int tex_w, tex_h;
+} UiPv;
+
+static UiPv ui_pv;
+
+static int ui_pv_gone(int gen)
+{
+    return ui_pv.quit || ui_pv.gen != gen;
+}
+
+/* Plays the file until it is not wanted any more. Returns 1 if the file could not be played. */
+static int ui_pv_run(const char *path, int gen)
+{
+    AVFormatContext *ic = NULL;
+    AVCodecContext *cc = NULL;
+    const AVCodec *codec = NULL;
+    AVFrame *fr = NULL;
+    AVPacket *pkt = NULL;
+    struct SwsContext *sws = NULL;
+    AVDictionary *opts = NULL;
+    uint8_t *buf = NULL;
+    double tb, dar, last_pts = 0.0, pts0;
+    int64_t wall0 = 0;
+    int vs, tw, th, i, failed = 1, shown = 0, restarts = 0;
+
+    av_dict_set(&opts, "probesize", "2000000", 0);
+    av_dict_set(&opts, "analyzeduration", "1000000", 0);
+    if (avformat_open_input(&ic, path, NULL, &opts) < 0) {
+        av_dict_free(&opts);
+        return 1;
+    }
+    av_dict_free(&opts);
+    if (avformat_find_stream_info(ic, NULL) < 0)
+        goto end;
+    vs = av_find_best_stream(ic, AVMEDIA_TYPE_VIDEO, -1, -1, &codec, 0);
+    if (vs < 0 || !codec || (ic->streams[vs]->disposition & AV_DISPOSITION_ATTACHED_PIC))
+        goto end;
+    cc = avcodec_alloc_context3(codec);
+    if (!cc || avcodec_parameters_to_context(cc, ic->streams[vs]->codecpar) < 0)
+        goto end;
+    cc->thread_count = 2;
+    cc->skip_loop_filter = AVDISCARD_ALL;       /* a small picture: the loop filter is not worth the time */
+    cc->flags2 |= AV_CODEC_FLAG2_FAST;
+    if (avcodec_open2(cc, codec, NULL) < 0)
+        goto end;
+    for (i = 0; i < (int)ic->nb_streams; i++)
+        if (i != vs)
+            ic->streams[i]->discard = AVDISCARD_ALL;
+    if (cc->width <= 0 || cc->height <= 0)
+        goto end;
+    {
+        AVRational sar = av_guess_sample_aspect_ratio(ic, ic->streams[vs], NULL);
+
+        dar = (double)cc->width / cc->height * (sar.num > 0 && sar.den > 0 ? av_q2d(sar) : 1.0);
+    }
+    if (dar >= 1.0) {
+        tw = UI_PV_SIDE;
+        th = (int)(UI_PV_SIDE / dar);
+    } else {
+        th = UI_PV_SIDE;
+        tw = (int)(UI_PV_SIDE * dar);
+    }
+    tw = FFMAX(tw & ~1, 2);
+    th = FFMAX(th & ~1, 2);
+    fr = av_frame_alloc();
+    pkt = av_packet_alloc();
+    buf = av_malloc((size_t)tw * th * 4);
+    if (!fr || !pkt || !buf)
+        goto end;
+    tb = av_q2d(ic->streams[vs]->time_base);
+    failed = 0;
+
+    while (!ui_pv_gone(gen) && restarts < 4) {
+        int ret;
+        double dur = ic->duration > 0 ? ic->duration / (double)AV_TIME_BASE : 0.0;
+        int64_t from = (dur > 12.0 ? (int64_t)(dur * 0.25 * AV_TIME_BASE) : 0) + (ic->start_time != AV_NOPTS_VALUE ? ic->start_time : 0);
+
+        if (av_seek_frame(ic, -1, from, AVSEEK_FLAG_BACKWARD) < 0)
+            av_seek_frame(ic, -1, 0, AVSEEK_FLAG_BACKWARD);
+        avcodec_flush_buffers(cc);
+        pts0 = -1.0;
+        restarts++;
+        for (;;) {
+            if (ui_pv_gone(gen))
+                break;
+            if (av_gettime_relative() - ui_pv.last_get > 2000000)
+                goto end;                       /* nobody is looking */
+            ret = av_read_frame(ic, pkt);
+            if (ret < 0)
+                break;                          /* the end: from the start again */
+            if (pkt->stream_index != vs) {
+                av_packet_unref(pkt);
+                continue;
+            }
+            ret = avcodec_send_packet(cc, pkt);
+            av_packet_unref(pkt);
+            if (ret < 0 && ret != AVERROR(EAGAIN))
+                continue;
+            while (!ui_pv_gone(gen) && avcodec_receive_frame(cc, fr) >= 0) {
+                int64_t now = av_gettime_relative(), target;
+                double pts = fr->best_effort_timestamp == AV_NOPTS_VALUE ? last_pts + 0.04 : fr->best_effort_timestamp * tb;
+                uint8_t *dst[4] = { buf, NULL, NULL, NULL };
+                int ls[4] = { tw * 4, 0, 0, 0 };
+
+                last_pts = pts;
+                if (pts0 < 0.0 || pts < pts0 - 0.5) {
+                    pts0 = pts;
+                    wall0 = now;
+                }
+                target = wall0 + (int64_t)((pts - pts0) * 1000000.0);
+                if (now > target + 250000) {    /* behind: this picture is skipped, and the clock starts again if it is far behind */
+                    if (now > target + 1000000) {
+                        pts0 = pts;
+                        wall0 = now;
+                    }
+                    av_frame_unref(fr);
+                    continue;
+                }
+                while (!ui_pv_gone(gen) && (now = av_gettime_relative()) < target)
+                    av_usleep((unsigned)FFMIN(target - now, 4000));
+                if (ui_pv_gone(gen)) {
+                    av_frame_unref(fr);
+                    break;
+                }
+                sws = sws_getCachedContext(sws, fr->width, fr->height, (enum AVPixelFormat)fr->format, tw, th, AV_PIX_FMT_RGBA,
+                                           SWS_FAST_BILINEAR, NULL, NULL, NULL);
+                if (!sws) {
+                    av_frame_unref(fr);
+                    failed = 1;
+                    goto end;
+                }
+                sws_scale(sws, (const uint8_t * const *)fr->data, fr->linesize, 0, fr->height, dst, ls);
+                av_frame_unref(fr);
+                SDL_LockMutex(ui_pv.mu);
+                if (ui_pv.gen == gen) {
+                    memcpy(ui_pv.pix, buf, (size_t)tw * th * 4);
+                    ui_pv.w = tw;
+                    ui_pv.h = th;
+                    ui_pv.fresh = 1;
+                    ui_pv.cgen = gen;
+                }
+                SDL_UnlockMutex(ui_pv.mu);
+                shown = 1;
+                restarts = 0;
+            }
+        }
+    }
+    if (!shown)
+        failed = 1;
+end:
+    sws_freeContext(sws);
+    av_free(buf);
+    av_packet_free(&pkt);
+    av_frame_free(&fr);
+    avcodec_free_context(&cc);
+    avformat_close_input(&ic);
+    return failed;
+}
+
+static int ui_pv_thread(void *arg)
+{
+    char path[4096];
+    int gen, failed;
+
+    (void)arg;
+    for (;;) {
+        SDL_LockMutex(ui_pv.mu);
+        while (!ui_pv.quit && !ui_pv.want[0])
+            SDL_CondWait(ui_pv.cv, ui_pv.mu);
+        if (ui_pv.quit) {
+            SDL_UnlockMutex(ui_pv.mu);
+            return 0;
+        }
+        snprintf(path, sizeof(path), "%s", ui_pv.want);
+        gen = ui_pv.gen;
+        SDL_UnlockMutex(ui_pv.mu);
+        failed = ui_pv_run(path, gen);
+        SDL_LockMutex(ui_pv.mu);
+        if (ui_pv.gen == gen) {                 /* it ended by itself: wait for the next request */
+            ui_pv.want[0] = 0;
+            if (failed)
+                snprintf(ui_pv.dead, sizeof(ui_pv.dead), "%s", path);
+        }
+        SDL_UnlockMutex(ui_pv.mu);
+    }
+}
+
+/* path = the file to play, NULL = stop */
+static void ui_pv_request(const char *path)
+{
+    if (!ui_pv.mu) {
+        if (!path)
+            return;
+        ui_pv.mu = SDL_CreateMutex();
+        ui_pv.cv = SDL_CreateCond();
+        ui_pv.pix = av_malloc((size_t)UI_PV_SIDE * UI_PV_SIDE * 4);
+        if (!ui_pv.mu || !ui_pv.cv || !ui_pv.pix)
+            return;
+        ui_pv.th = SDL_CreateThread(ui_pv_thread, "ffplay-custom preview", NULL);
+        if (!ui_pv.th) {
+            ui_pv.mu = NULL;                    /* no thread: no previews (a later try starts again) */
+            return;
+        }
+        SDL_DetachThread(ui_pv.th);
+    }
+    SDL_LockMutex(ui_pv.mu);
+    if (!path) {
+        if (ui_pv.want[0]) {
+            ui_pv.want[0] = 0;
+            ui_pv.gen++;
+        }
+    } else if (strcmp(path, ui_pv.want) && strcmp(path, ui_pv.dead)) {
+        snprintf(ui_pv.want, sizeof(ui_pv.want), "%s", path);
+        ui_pv.dead[0] = 0;
+        ui_pv.gen++;
+        ui_pv.fresh = 0;
+        ui_pv.last_get = av_gettime_relative();
+        SDL_CondSignal(ui_pv.cv);
+    }
+    SDL_UnlockMutex(ui_pv.mu);
+}
+
+/* The texture of the picture that plays for this file, or NULL if it is not the one that is wanted (or has no picture yet) */
+static SDL_Texture *ui_pv_get(const char *path, int *w, int *h)
+{
+    SDL_Texture *t = NULL;
+
+    if (!ui_pv.mu || !path)
+        return NULL;
+    SDL_LockMutex(ui_pv.mu);
+    if (ui_pv.want[0] && !strcmp(path, ui_pv.want)) {
+        ui_pv.last_get = av_gettime_relative();
+        if (ui_pv.cgen == ui_pv.gen && ui_pv.w > 0 && ui_pv.h > 0) {
+            if (!ui_pv.tex || ui_pv.tex_w != ui_pv.w || ui_pv.tex_h != ui_pv.h) {
+                if (ui_pv.tex)
+                    SDL_DestroyTexture(ui_pv.tex);
+                ui_pv.tex = SDL_CreateTexture(renderer, SDL_PIXELFORMAT_RGBA32, SDL_TEXTUREACCESS_STREAMING, ui_pv.w, ui_pv.h);
+                ui_pv.tex_w = ui_pv.w;
+                ui_pv.tex_h = ui_pv.h;
+                ui_pv.fresh = 1;
+                if (ui_pv.tex)
+                    SDL_SetTextureBlendMode(ui_pv.tex, SDL_BLENDMODE_BLEND);
+            }
+            if (ui_pv.tex && ui_pv.fresh) {
+                SDL_UpdateTexture(ui_pv.tex, NULL, ui_pv.pix, ui_pv.w * 4);
+                ui_pv.fresh = 0;
+            }
+            if (ui_pv.tex) {
+                t = ui_pv.tex;
+                *w = ui_pv.w;
+                *h = ui_pv.h;
+            }
+        }
+    }
+    SDL_UnlockMutex(ui_pv.mu);
+    return t;
+}
+
+static int ui_tv_is_playing(const char *path)
+{
+    return path && q_pos >= 0 && q_pos < q_count && !strcmp(path, q_items[q_pos]);
+}
+
+typedef struct {
+    int sec;                                    /* -1 = the queue itself, 0 to 2 = the matches of a section */
+    int first, count;                           /* the queue numbers of the row (sec -1), or 0 and the number of matches */
+    double pos;                                 /* the column in the focus place */
+    int cx, cy, sw, sh;                         /* where the focus tile sits, and the size of the box a tile is fitted into */
+    double rowd;                                /* how far this row is from the row in focus (0 = in focus) */
+    int64_t born;
+    int sm;                                     /* a small window: smaller titles */
+} UiTvRow;
+
+typedef struct {
+    double d;
+    int c;
+} UiTvOrd;
+
+static int ui_tv_ord_cmp(const void *a, const void *b)
+{
+    double x = ((const UiTvOrd *)a)->d, y = ((const UiTvOrd *)b)->d;
+
+    return x < y ? 1 : x > y ? -1 : 0;
+}
+
+static const char *ui_tv_row_path(const UiTvRow *R, int c)
+{
+    if (R->sec < 0)
+        return q_items[R->first + c];
+    return ui_tv_sec[R->sec].h[c].path;
+}
+
+static void ui_tv_row_draw(VideoState *is, const UiTvRow *R, int hov_sec, int hov_item, double dt, int64_t now, double ep)
+{
+    UiTvOrd ord[48];
+    int no = 0, k0, k1, c, o, W = is->width, vm = ui_flow_vmode, K;
+    double pitch = R->sw * 1.08;
+
+    K = (int)(W / (2.0 * pitch)) + 3;
+    k0 = FFMAX((int)floor(R->pos) - K, 0);
+    k1 = FFMIN((int)ceil(R->pos) + 2 * K, R->count - 1);     /* v39: a row that starts at the far left shows more tiles to the right */
+    for (c = k0; c <= k1 && no < 48; c++) {
+        double dc = c - R->pos, dce = dc, d;
+
+        if (R->sec < 0 && R->rowd > 0.0) {      /* v39: the shift to the far left (see below) moves the tile, so its size and brightness follow */
+            double pmax = W / 2.0 / pitch - 0.6;
+
+            if (pmax > 0.0 && R->pos < pmax)
+                dce -= (pmax - R->pos) * FFMIN(R->rowd, 1.0);
+        }
+        d = sqrt(dce * dce + (1.15 * R->rowd) * (1.15 * R->rowd));
+
+        ord[no].d = d;
+        ord[no].c = c;
+        no++;
+    }
+    qsort(ord, no, sizeof(ord[0]), ui_tv_ord_cmp);              /* the far ones first, the one in focus on top */
+    for (o = 0; o < no; o++) {
+        int c = ord[o].c, item = R->sec < 0 ? R->first + c : c, play, nw, nh, al, md, tx, ty, ti, la;
+        double d = ord[o].d, dc = c - R->pos, sc, x, en, ease, x1, lf, goal, asp, bw, bh;
+        const char *path = ui_tv_row_path(R, c);
+        SDL_Texture *ptex;
+        int pw = 0, ph = 0;
+        const unsigned char *hl = R->sec >= 0 ? ui_tv_sec[R->sec].h[c].hl : NULL;
+        SDL_Rect tile;
+        char name[320];
+        int px;
+
+        if (!path)
+            continue;
+        play = ui_tv_is_playing(path);
+        sc = 1.0 - 0.26 * (d < 1.0 ? d * d * (3.0 - 2.0 * d) : 1.0) - 0.035 * FFMIN(FFMAX(d - 1.0, 0.0), 4.0);
+        bw = R->sw * sc;
+        bh = R->sh * sc;
+        asp = (play && vm && ui_live_ok && ui_live_rect.h > 0) ? (double)ui_live_rect.w / ui_live_rect.h : ui_cov_aspect(path);
+        ptex = play ? NULL : ui_pv_get(path, &pw, &ph);         /* v39: the picture that plays under the mouse */
+        if (ptex && asp <= 0.0)
+            asp = (double)pw / ph;
+        if (asp <= 0.0) {
+            nw = nh = (int)FFMIN(bw, bh);       /* a cover or a file icon is square */
+        } else if (bw / bh > asp) {
+            nh = (int)bh;
+            nw = (int)(bh * asp);
+        } else {
+            nw = (int)bw;
+            nh = (int)(bw / asp);
+        }
+        x = R->cx + dc * pitch + (dc < 0 ? -1.0 : 1.0) * FFMIN(fabs(dc), 1.0) * pitch * 0.12;
+        if (R->sec < 0 && R->rowd > 0.0) {      /* v39: the rows that are not in focus start at the far left, until the focus has gone far enough */
+            double pmax = W / 2.0 / pitch - 0.6;
+
+            if (pmax > 0.0 && R->pos < pmax)
+                x -= (pmax - R->pos) * pitch * FFMIN(R->rowd, 1.0);
+        }
+        if (vm && R->sec < 0 && !play)          /* over a video: the other tiles slide out from behind the one that plays */
+            x = R->cx + (x - R->cx) * (0.55 + 0.45 * ep);
+        en = (R->sec < 0 && vm) ? 1.0 : av_clipd(((now - R->born) / 1000000.0 - fabs(dc) * 0.05) / 0.45, 0.0, 1.0);
+        if (en < 1.0)
+            ui_tv_moving = 1;
+        x1 = en - 1.0;
+        ease = 1.0 + 2.70158 * x1 * x1 * x1 + 1.70158 * x1 * x1;                 /* eases out and overshoots a little */
+        x += (1.0 - ease) * (dc < 0 ? -1.0 : 1.0) * W * 0.12;
+        al = (int)(255 * av_clipd(1.05 - 0.17 * d, 0.5, 1.0) * av_clipd(1.0 - 0.25 * R->rowd, 0.78, 1.0));     /* v43: lighter than before, so they can be read */
+        md = (int)(255 * av_clipd(1.0 - 0.12 * FFMIN(d, 2.5), 0.72, 1.0));
+        if (vm && R->sec < 0 && !play)
+            al = (int)(al * ep);                /* the other tiles fade in while the video shrinks */
+        al = (int)(al * en);
+        ti = (int)(((R->sec + 1) * 1031 + item) % 4093);        /* v39: one slot for each tile */
+        goal = (hov_sec == R->sec && hov_item == item) ? 1.0 : 0.0;
+        lf = ui_tv_lift[ti];
+        lf += (goal - lf) * (1.0 - exp(-dt * 14.0));
+        if (fabs(goal - lf) < 0.004)
+            lf = goal;
+        else
+            ui_tv_moving = 1;
+        ui_tv_lift[ti] = lf;
+        al += (int)((255 - al) * lf);           /* v39: the tile under the mouse brightens like the one that plays */
+        md += (int)((255 - md) * lf);
+        nw += (int)(nw * 0.05 * lf);
+        nh += (int)(nh * 0.05 * lf);
+        tile.w = nw;
+        tile.h = nh;
+        tile.x = (int)x - nw / 2;
+        tile.y = R->cy + (int)((1.0 - ease) * 36.0) - nh / 2 - (int)(6 * lf);
+        md = FFMIN(255, md + (int)(40 * lf));
+        if (tile.x + tile.w < -20 || tile.x > W + 20)
+            continue;
+        if (ui_tv_drag && ui_tv_press == item && ui_tv_pressec == R->sec)
+            al = al / 3;                        /* the one that is being dragged leaves a faint place behind */
+        if (d < 0.6)                            /* a soft glow in the bar color behind the tile in focus, like the reference */
+            ui_tv_glow(tile.x + tile.w / 2.0, tile.y + tile.h / 2.0, tile.w * 0.95, tile.h * 0.95,
+                       (int)(120 * (1.0 - d / 0.6) * (((vm && R->sec < 0 && play) ? al * ep * ep : al) / 255.0)));
+        if (play && vm && ui_live_ok) {         /* the video that plays now keeps playing in its tile */
+            SDL_Rect lr = tile;
+
+            if (ep < 1.0) {                     /* on its way between the full screen and its tile */
+                lr.x = ui_live_rect.x + (int)((tile.x - ui_live_rect.x) * ep);
+                lr.y = ui_live_rect.y + (int)((tile.y - ui_live_rect.y) * ep);
+                lr.w = ui_live_rect.w + (int)((tile.w - ui_live_rect.w) * ep);
+                lr.h = ui_live_rect.h + (int)((tile.h - ui_live_rect.h) * ep);
+            }
+            ui_flow_quad_round(ui_live_tex, &lr, al, md, 0.0, (int)(FFMIN(lr.w, lr.h) / 11.0 * ep));
+        } else if (ptex) {                      /* it plays under the mouse */
+            ui_flow_quad_round(ptex, &tile, al, md, 0.0, FFMIN(tile.w, tile.h) / 11);
+            ui_tv_moving = 1;
+        } else {
+            ui_tv_tile(path, &tile, al, md);
+        }
+        ui_tv_name(path, name, sizeof(name));
+        px = d < 0.6 ? (R->sm ? 16 : 19) : (R->sm ? 12 : 14);
+        tx = tile.x + tile.w / 2;
+        ty = tile.y + tile.h + (d < 0.6 ? 20 : 16);
+        la = (vm && R->sec < 0 && play) ? (int)(al * ep * ep) : al;     /* v43: over a video the title goes with the video growing back */
+        if (play) {                             /* the dot of the item that plays, before its title */
+            SDL_Rect pdot;
+            int tw = ui_text_width(name, px);
+
+            pdot.w = 7;
+            pdot.h = 7;
+            pdot.x = tx - FFMIN(tw, (int)(pitch * 1.4)) / 2 - 14;
+            pdot.y = ty - 3;
+            SDL_SetRenderDrawColor(renderer, av_clip(cfg_bar_r + 40, 0, 255), av_clip(cfg_bar_g + 40, 0, 255),
+                                   av_clip(cfg_bar_b + 40, 0, 255), (int)(235 * la / 255.0));
+            ui_pill(&pdot);
+        }
+        ui_tv_label(name, hl, px, tx, ty, (int)(pitch * (d < 0.6 ? 1.9 : 1.05)), (int)(la * (d < 0.6 ? 1.0 : 0.75 + 0.25 * lf)));
+        if (ui_tvh_n < 128) {
+            ui_tvh[ui_tvh_n].r.x = tile.x;
+            ui_tvh[ui_tvh_n].r.y = tile.y;
+            ui_tvh[ui_tvh_n].r.w = tile.w;
+            ui_tvh[ui_tvh_n].r.h = tile.h + 30;
+            ui_tvh[ui_tvh_n].sec = R->sec;
+            ui_tvh[ui_tvh_n].item = item;
+            ui_tvh_n++;
+        }
+    }
+}
+
+static int ui_tv_hit_at(int x, int y, int *sec, int *item)
+{
+    int i;
+
+    for (i = ui_tvh_n - 1; i >= 0; i--) {       /* the last one drawn is the nearest */
+        const SDL_Rect *r = &ui_tvh[i].r;
+
+        if (x >= r->x && x < r->x + r->w && y >= r->y && y < r->y + r->h) {
+            *sec = ui_tvh[i].sec;
+            *item = ui_tvh[i].item;
+            return 1;
+        }
+    }
+    return 0;
+}
+
+static void ui_tv_draw(VideoState *is)
+{
+    int64_t now = av_gettime_relative();
+    int W = is->width, H = is->height, vm, R, L, s, ctop, cbot, hs = -2, hi = -1, sm = H < 460;
+    double dt, ep = 1.0, t = now / 1000000.0;
+    SDL_Rect box;
+    static int last_q = -2;
+
+    ui_flow_vmode = vm = ui_flow_video(is);
+    ui_flow_n = 0;
+    ui_flow_moving = 0;
+    ui_tp_stop();
+    if (W < 260 || H < 200)
+        return;
+    if (now - ui_tv_seen > 350000)
+        ui_tv_reset(is, now);                   /* the view has just opened */
+    ui_tv_seen = now;
+    ui_tv_moving = 0;
+    dt = ui_tv_t ? av_clipd((now - ui_tv_t) / 1000000.0, 0.0, 0.1) : 0.0;
+    ui_tv_t = now;
+    if (vm) {                                   /* the video shrinks into its tile (or grows back): the same animation as before */
+        double want = ui_vflow ? 1.0 : 0.0, dtv = ui_vflow_t ? av_clipd((now - ui_vflow_t) / 1000000.0, 0.0, 0.1) : 0.0;
+
+        ui_vflow_t = now;
+        ui_vflow_p += (want - ui_vflow_p) * (1.0 - exp(-dtv * (want > 0.5 ? 8.0 : 14.0)));      /* growing back is quicker */
+        if (fabs(want - ui_vflow_p) < (want > 0.5 ? 0.004 : 0.03))      /* v43: the last part of the way back is not seen: it ends there */
+            ui_vflow_p = want;
+        ui_vflow_ep = ui_vflow_p * ui_vflow_p * (3.0 - 2.0 * ui_vflow_p);
+        ep = ui_vflow_ep;
+        if (ui_vflow_p != want)
+            ui_tv_moving = 1;
+    }
+    if (q_pos != last_q) {                      /* a new item started: the focus goes to it */
+        last_q = q_pos;
+        if (!ui_tv_q[0])
+            ui_tv_focus = q_pos;
+    }
+    ui_tv_focus = av_clip(ui_tv_focus, 0, q_count - 1);
+    ui_tv_dims(is, &R, &L);
+    if (ui_hov_x >= 0 && !ui_menu_open && !ui_prefs_open && !ui_tv_drag)
+        if (!ui_tv_hit_at(ui_hov_x, ui_hov_y, &hs, &hi))
+            hs = -2;
+    if (ui_tvc_open)
+        hs = -2;                                /* v39: no tile is under the mouse while its menu is open */
+    ui_tv_hover_preview(hs, hi, now);
+    ui_tvh_n = 0;
+
+    SDL_SetRenderDrawBlendMode(renderer, SDL_BLENDMODE_BLEND);
+    SDL_SetRenderDrawColor(renderer, 0, 0, 0, (int)(110 * ep));         /* the tiles read better on a calmer picture */
+    SDL_RenderFillRect(renderer, NULL);
+
+    box.w = av_clip((int)(W * 0.6), 180, 560);          /* the search box */
+    box.h = sm ? 30 : 38;
+    box.x = (W - box.w) / 2;
+    box.y = sm ? 34 : 44;
+    {
+        int r, g, b, tx = box.x + 18, cy = box.y + box.h / 2, al = (int)(255 * ep);
+        SDL_Rect caret;
+
+        ui_glass(&box, box.h / 2);
+        ui_tv_theme(&r, &g, &b);
+        if (ui_tv_q[0]) {
+            ui_label(tx, cy, ui_tv_q, sm ? 15 : 18, 255, 255, 255, al);
+            caret.x = tx + ui_text_width(ui_tv_q, sm ? 15 : 18) + 2;
+        } else {
+            ui_label(tx, cy, "Search the queue, your music and your videos", sm ? 15 : 17, 255, 255, 255, al * 68 / 100);
+            caret.x = tx - 2;
+        }
+        if (ui_tv_searching || ui_tv_q[0]) {    /* a caret in the bar color that blinks */
+            if (fmod(t, 1.0) < 0.6) {
+                caret.y = cy - (sm ? 9 : 11);
+                caret.w = 2;
+                caret.h = sm ? 18 : 22;
+                SDL_SetRenderDrawColor(renderer, r, g, b, al);
+                SDL_RenderFillRect(renderer, &caret);
+            }
+            ui_tv_moving = 1;
+        }
+    }
+    ctop = box.y + box.h + (sm ? 10 : 18);
+    cbot = H - (sm ? 40 : 58);
+
+    if (!ui_tv_q[0]) {                          /* browsing: the queue in rows, the lower row continues the upper one */
+        UiTvRow row;
+        double avail = cbot - ctop, rp = avail / R, sh, col = ui_tv_focus % L, rw = ui_tv_focus / L;
+        int r;
+
+        sh = av_clipd(FFMIN(FFMIN(rp * 0.74, rp - 46.0), W * 0.24), 40.0, 340.0);      /* v38: bigger */
+        ui_tv_pos += (col - ui_tv_pos) * (1.0 - exp(-dt * 9.0));
+        ui_tv_row += (rw - ui_tv_row) * (1.0 - exp(-dt * 9.0));
+        if (fabs(col - ui_tv_pos) < 0.003)
+            ui_tv_pos = col;
+        else
+            ui_tv_moving = 1;
+        if (fabs(rw - ui_tv_row) < 0.003)
+            ui_tv_row = rw;
+        else
+            ui_tv_moving = 1;
+        for (r = 0; r < R; r++) {               /* the row in focus is drawn last, so it is on top */
+            int rr = (r + (int)floor(ui_tv_row + 0.5) + 1) % R;
+
+            row.sec = -1;
+            row.first = rr * L;
+            row.count = FFMIN(L, q_count - rr * L);
+            if (row.count <= 0)
+                continue;
+            row.pos = FFMIN(ui_tv_pos, row.count - 1);
+            row.cx = W / 2;
+            row.cy = ctop + (int)(rp * (rr + 0.5)) - 8;
+            row.sw = (int)(sh * (ui_tv_audio ? 1.22 : 1.75));        /* v39: music tiles sit closer */
+            row.sh = (int)sh;
+            row.rowd = fabs(rr - ui_tv_row);
+            row.born = ui_tv_born;
+            row.sm = sm;
+            ui_tv_row_draw(is, &row, hs, hi, dt, now, ep);
+        }
+        if (!sm && ep > 0.9 && W > 480)         /* a quiet hint under the rows */
+            ui_label_c(W / 2, H - 46, "Type to search     Enter plays     Esc closes", 13, 255, 255, 255, (int)(95 * ep));
+    } else {                                    /* searching: three sections, each its own row of matches, the best one in focus */
+        double secH = (cbot - ctop) / 3.0;
+        int sh = (int)av_clipd(FFMIN(secH - 24 - 30, W * 0.2), 36.0, 260.0), tr, tg, tb;     /* v38: bigger */
+
+        ui_tv_theme(&tr, &tg, &tb);
+        for (s = 0; s < 3; s++) {
+            UiTvSec *sec = &ui_tv_sec[s];
+            UiTvRow row;
+            int top = ctop + (int)(secH * s), hy = top + 12, a = s == ui_tv_act ? 235 : 150;
+            char head[96];
+            SDL_Rect mark;
+
+            ui_tv_secy[s][0] = top;
+            ui_tv_secy[s][1] = top + (int)secH;
+            snprintf(head, sizeof(head), "%s", ui_tv_title[s]);
+            mark.x = 24;
+            mark.y = hy - 7;
+            mark.w = 3;
+            mark.h = 14;
+            SDL_SetRenderDrawColor(renderer, tr, tg, tb, a);
+            ui_pill(&mark);
+            ui_label(34, hy, head, sm ? 14 : 16, 255, 255, 255, a);
+            if (sec->n > 0) {
+                char cnt[24];
+
+                snprintf(cnt, sizeof(cnt), "%d", sec->n);
+                ui_label(34 + ui_text_width(head, sm ? 14 : 16) + 10, hy, cnt, sm ? 12 : 13, 255, 255, 255, 110);
+            }
+            sec->target = av_clip(sec->target, 0, FFMAX(sec->n - 1, 0));
+            sec->pos += (sec->target - sec->pos) * (1.0 - exp(-dt * 9.0));
+            if (fabs(sec->target - sec->pos) < 0.003)
+                sec->pos = sec->target;
+            else
+                ui_tv_moving = 1;
+            if (sec->n == 0) {
+                const char *msg = (s > 0 && ui_tv_scan_state == 1) ? "Looking through your folders..." : "Nothing matches";
+
+                ui_label(34, top + 12 + 28, msg, 14, 255, 255, 255, 95);
+                continue;
+            }
+            row.sec = s;
+            row.first = 0;
+            row.count = sec->n;
+            row.pos = sec->pos;
+            row.cx = (int)(W * 0.30);
+            row.cy = top + 24 + sh / 2 + 6;
+            row.sw = (int)(sh * (s == 1 ? 1.22 : 1.75));            /* v39: music tiles sit closer */
+            row.sh = sh;
+            row.rowd = s == ui_tv_act ? 0.0 : 0.45;
+            row.born = sec->born;
+            row.sm = sm;
+            ui_tv_row_draw(is, &row, hs, hi, dt, now, ep);
+        }
+        if (ui_tv_scan_state == 1)
+            ui_tv_moving = 1;                   /* the folders are still being read: the lists grow */
+    }
+    if (ui_tv_drag && ui_tv_press >= 0 && ui_tv_pressec == -1 && ui_tv_press < q_count) {       /* the tile that is being dragged, under the mouse */
+        SDL_Rect g;
+        int hs2, hi2;
+        const char *p = q_items[ui_tv_press];
+        double asp = ui_cov_aspect(p);
+
+        {                                       /* v43: near an edge the view scrolls, so the tile can be taken further than the ones in sight */
+            static int64_t last_scroll = 0;
+            double ex = FFMIN(W * 0.09, 170.0), ey = FFMIN(H * 0.13, 130.0), depth = 0.0;
+            int dx = 0, dy = 0;
+
+            if (ui_hov_x >= 0 && ui_hov_x < ex) {
+                dx = -1;
+                depth = 1.0 - ui_hov_x / ex;
+            } else if (ui_hov_x > W - ex) {
+                dx = 1;
+                depth = 1.0 - (W - ui_hov_x) / ex;
+            }
+            if (ui_hov_y >= 0 && ui_hov_y < ey) {
+                dy = -1;
+                depth = FFMAX(depth, 1.0 - ui_hov_y / ey);
+            } else if (ui_hov_y > H - ey) {
+                dy = 1;
+                depth = FFMAX(depth, 1.0 - (H - ui_hov_y) / ey);
+            }
+            if ((dx || dy) && !ui_tv_q[0]) {
+                if (now - last_scroll > (int64_t)((400.0 - 280.0 * av_clipd(depth, 0.0, 1.0)) * 1000.0)) {
+                    last_scroll = now;
+                    ui_tv_step(is, dx, dy);     /* one tile (or row) at a time, quicker the nearer the edge */
+                }
+                ui_tv_moving = 1;
+            }
+        }
+        g.h = (int)FFMIN(H * 0.2, 140);
+        g.w = asp > 0.0 ? (int)(g.h * asp) : g.h;
+        g.x = ui_hov_x - g.w / 2;
+        g.y = ui_hov_y - g.h / 2;
+        ui_tv_tile(p, &g, 215, 255);
+        if (ui_tv_hit_at(ui_hov_x, ui_hov_y, &hs2, &hi2) && hs2 == -1 && hi2 != ui_tv_press) {      /* the place it would take */
+            SDL_Rect m = { 0, 0, 0, 0 };
+            int k;
+
+            for (k = ui_tvh_n - 1; k >= 0; k--)
+                if (ui_tvh[k].sec == -1 && ui_tvh[k].item == hi2) {
+                    m = ui_tvh[k].r;
+                    break;
+                }
+            SDL_SetRenderDrawColor(renderer, av_clip(cfg_bar_r + 40, 0, 255), av_clip(cfg_bar_g + 40, 0, 255),
+                                   av_clip(cfg_bar_b + 40, 0, 255), 220);
+            SDL_RenderDrawRect(renderer, &m);
+        }
+        ui_tv_moving = 1;
+    }
+    if (ui_tvc_open)
+        ui_tvc_draw(is);
+    SDL_RenderSetClipRect(renderer, NULL);
+}
+
+/* ---- the mouse ---- */
+static int ui_tv_click(VideoState *is, int x, int y)
+{
+    int sec, item;
+
+    if (!ui_tv_hit_at(x, y, &sec, &item))
+        return 0;
+    ui_tv_press = item;
+    ui_tv_pressec = sec;
+    ui_tv_drag = 0;
+    ui_tv_px = x;
+    ui_tv_py = y;
+    return 1;
+}
+
+static int ui_tv_motion(VideoState *is, int x, int y)
+{
+    ui_hov_x = x;
+    ui_hov_y = y;
+    if (ui_tv_press < 0)
+        return 0;
+    if (!ui_tv_drag && ui_tv_pressec == -1 && (FFABS(x - ui_tv_px) >= 8 || FFABS(y - ui_tv_py) >= 8)) {
+        ui_tv_drag = 1;                         /* held and moved: the tile is dragged to a new place in the queue */
+        SDL_CaptureMouse(SDL_TRUE);
+    }
+    is->force_refresh = 1;
+    return 1;
+}
+
+static int ui_tv_release(VideoState *is, int x, int y)
+{
+    int item = ui_tv_press, sec = ui_tv_pressec, s2, i2;
+
+    if (item < 0)
+        return 0;
+    ui_tv_press = -1;
+    if (ui_tv_drag) {
+        ui_tv_drag = 0;
+        SDL_CaptureMouse(SDL_FALSE);
+        if (ui_tv_hit_at(x, y, &s2, &i2) && s2 == -1 && i2 != item && item < q_count) {
+            queue_move(item, i2);               /* dropped on another tile: it takes that place */
+            ui_tv_focus = i2;
+        }
+    } else if (sec == -1) {
+        if (item == ui_tv_focus)
+            ui_tv_play(is, q_items[av_clip(item, 0, q_count - 1)]);     /* a tap on the tile in focus plays it */
+        else
+            ui_tv_focus = item;                 /* a tap on another tile brings it into focus */
+    } else if (sec >= 0 && sec < 3) {
+        if (item == ui_tv_sec[sec].target && ui_tv_act == sec)
+            ui_tv_play(is, ui_tv_sec[sec].h[av_clip(item, 0, FFMAX(ui_tv_sec[sec].n - 1, 0))].path);
+        else {
+            ui_tv_act = sec;
+            ui_tv_sec[sec].target = item;
+        }
+    }
+    ui_tv_moving = 1;
+    is->force_refresh = 1;
+    return 1;
+}
+
+/* ---- v39: what is under the mouse in the view: the tile that plays, and the right-click menu ---- */
+static const char *ui_tv_item_path(int sec, int item)
+{
+    if (item < 0)
+        return NULL;
+    if (sec == -1)
+        return item < q_count ? q_items[item] : NULL;
+    if (sec >= 0 && sec < 3 && item < ui_tv_sec[sec].n)
+        return ui_tv_sec[sec].h[item].path;
+    return NULL;
+}
+
+static int ui_tv_ext_is(const char *path, int kind)
+{
+    const char *dot = strrchr(path, '.'), *slash = strrchr(path, '/');
+    int i;
+
+    if (!dot || (slash && dot < slash))
+        return 0;
+    for (i = 0; ui_tv_ext[kind][i]; i++)
+        if (!av_strcasecmp(dot + 1, ui_tv_ext[kind][i]))
+            return 1;
+    return 0;
+}
+
+/* The video under the mouse starts to play in its tile after a short rest, and stops a moment after the mouse has left it */
+static void ui_tv_hover_preview(int hs, int hi, int64_t now)
+{
+    static char dw[4096];
+    static int64_t since = 0, lost = 0;
+    const char *p = hs >= -1 ? ui_tv_item_path(hs, hi) : NULL;
+
+    if (p && ui_tv_ext_is(p, 1) && !ui_tv_is_playing(p)) {
+        lost = 0;
+        if (strcmp(p, dw)) {
+            snprintf(dw, sizeof(dw), "%s", p);
+            since = now;
+        }
+        if (now - since >= 300000)
+            ui_pv_request(p);
+        else
+            ui_tv_moving = 1;
+    } else {
+        dw[0] = 0;
+        if (!lost)
+            lost = now;
+        if (now - lost > 400000)
+            ui_pv_request(NULL);
+    }
+}
+
+#define UI_TVC_ROW 38
+static int ui_tvc_x = 0, ui_tvc_y = 0, ui_tvc_hover = -1, ui_tvc_n = 0, ui_tvc_act[4];
+static char ui_tvc_path[4096];
+static const char * const ui_tvc_label[4] = { "Play", "Play next", "Add to queue", "Remove from queue" };
+
+static int ui_tv_qindex(const char *path)       /* the place of a file in the queue (the same file under another name counts), or -1 */
+{
+    int i, idx = -1;
+    char *rp;
+
+    for (i = 0; i < q_count && idx < 0; i++)
+        if (!strcmp(q_items[i], path))
+            idx = i;
+    if (idx >= 0)
+        return idx;
+    rp = realpath(path, NULL);
+    for (i = 0; rp && i < q_count && idx < 0; i++) {
+        char *rq = realpath(q_items[i], NULL);
+
+        if (rq && !strcmp(rq, rp))
+            idx = i;
+        free(rq);
+    }
+    free(rp);
+    return idx;
+}
+
+static SDL_Rect ui_tvc_rect(int ww, int wh)
+{
+    SDL_Rect r;
+    int i, w = 0;
+
+    for (i = 0; i < ui_tvc_n; i++)
+        w = FFMAX(w, ui_text_width(ui_tvc_label[ui_tvc_act[i]], 18));
+    r.w = w + 56;
+    r.h = ui_tvc_n * UI_TVC_ROW + 16;
+    r.x = av_clip(ui_tvc_x, 8, FFMAX(ww - r.w - 8, 8));
+    r.y = av_clip(ui_tvc_y, 8, FFMAX(wh - r.h - 8, 8));
+    return r;
+}
+
+static int ui_tvc_hit(const SDL_Rect *r, int x, int y)
+{
+    if (x < r->x || x >= r->x + r->w || y < r->y + 8 || y >= r->y + 8 + ui_tvc_n * UI_TVC_ROW)
+        return -1;
+    return (y - r->y - 8) / UI_TVC_ROW;
+}
+
+static void ui_tvc_draw(VideoState *is)
+{
+    SDL_Rect r = ui_tvc_rect(is->width, is->height);
+    int i, ry;
+
+    ui_glass(&r, 16);
+    SDL_SetRenderDrawBlendMode(renderer, SDL_BLENDMODE_BLEND);
+    for (i = 0; i < ui_tvc_n; i++) {
+        ry = r.y + 8 + i * UI_TVC_ROW;
+        ui_label(r.x + 30, ry + UI_TVC_ROW / 2, ui_tvc_label[ui_tvc_act[i]], 18, 240, 240, 240, i == ui_tvc_hover ? 255 : 205);
+        if (i == ui_tvc_hover) {
+            SDL_Rect dot = { r.x + 13, ry + UI_TVC_ROW / 2 - 3, 6, 6 };
+
+            SDL_SetRenderDrawColor(renderer, av_clip(cfg_bar_r + 40, 0, 255), av_clip(cfg_bar_g + 40, 0, 255),
+                                   av_clip(cfg_bar_b + 40, 0, 255), 235);
+            ui_pill(&dot);
+        }
+    }
+    ui_tv_moving = 1;
+}
+
+static void ui_tvc_do(VideoState *is, int act)
+{
+    char path[4096];
+    int idx;
+
+    snprintf(path, sizeof(path), "%s", ui_tvc_path);
+    ui_tvc_open = 0;
+    ui_tvc_hover = -1;
+    switch (act) {
+    case 0:                                     /* Play */
+        ui_tv_play(is, path);
+        break;
+    case 1:                                     /* Play next: right after the item that plays */
+        idx = ui_tv_qindex(path);
+        if (idx < 0) {
+            queue_add(path);
+            idx = ui_tv_qindex(path);
+        }
+        if (idx >= 0 && idx != q_pos && idx != q_pos + 1)
+            queue_move(idx, idx > q_pos ? q_pos + 1 : q_pos);
+        break;
+    case 2:                                     /* Add to queue */
+        if (ui_tv_qindex(path) < 0)
+            queue_add(path);
+        break;
+    default:                                    /* Remove from queue */
+        idx = ui_tv_qindex(path);
+        if (idx >= 0 && idx != q_pos)
+            queue_remove(idx);
+        break;
+    }
+    if (ui_tv_q[0] && act != 0)
+        ui_tv_search();                         /* "In this queue" follows what changed */
+    ui_tv_moving = 1;
+    is->force_refresh = 1;
+}
+
+/* The mouse, while the view is open: right-click on a tile opens its menu, and the menu owns the mouse until it closes */
+static int ui_tv_ctx_mouse(VideoState *is, SDL_Event *ev)
+{
+    SDL_Rect r;
+    int x, y, hit, sec, item, qi, n = 0;
+    const char *p;
+
+    if (ev->type != SDL_MOUSEBUTTONDOWN && ev->type != SDL_MOUSEMOTION)
+        return 0;
+    if (!ui_tv_on(is)) {
+        ui_tvc_open = 0;
+        return 0;
+    }
+    x = ev->type == SDL_MOUSEMOTION ? ev->motion.x : ev->button.x;
+    y = ev->type == SDL_MOUSEMOTION ? ev->motion.y : ev->button.y;
+    if (ui_tvc_open) {
+        r = ui_tvc_rect(is->width, is->height);
+        hit = ui_tvc_hit(&r, x, y);
+        if (ev->type == SDL_MOUSEMOTION)
+            ui_tvc_hover = hit;
+        else if (ev->button.button == SDL_BUTTON_LEFT && hit >= 0)
+            ui_tvc_do(is, ui_tvc_act[hit]);
+        else
+            ui_tvc_open = 0;                    /* a click anywhere else closes it */
+        ui_wake();
+        is->force_refresh = 1;
+        return 1;
+    }
+    if (ev->type != SDL_MOUSEBUTTONDOWN || ev->button.button != SDL_BUTTON_RIGHT || ui_tv_drag)
+        return 0;
+    if (!ui_tv_hit_at(x, y, &sec, &item) || !(p = ui_tv_item_path(sec, item)))
+        return 0;
+    snprintf(ui_tvc_path, sizeof(ui_tvc_path), "%s", p);
+    qi = ui_tv_qindex(p);
+    ui_tvc_act[n++] = 0;                        /* Play */
+    if (qi < 0 || (qi != q_pos && qi != q_pos + 1))
+        ui_tvc_act[n++] = 1;                    /* Play next */
+    if (qi < 0)
+        ui_tvc_act[n++] = 2;                    /* Add to queue */
+    else if (qi != q_pos)
+        ui_tvc_act[n++] = 3;                    /* Remove from queue */
+    ui_tvc_n = n;
+    ui_tvc_x = x;
+    ui_tvc_y = y;
+    ui_tvc_hover = -1;
+    ui_tvc_open = 1;
+    ui_pv_request(NULL);
+    ui_wake();
+    is->force_refresh = 1;
+    return 1;
+}
+
+static void ui_flow_draw(VideoState *is)
+{
+    enum { NEQ = 72 };
+    int sm, npx, gy, hov_i = -1;
+    static float eq[NEQ], lvl = 0.0f;
+    static int64_t eq_at = 0;
+    int64_t now = av_gettime_relative();
+    int W = is->width, H = is->height, i, j, pass, cx, cy, ci, nb, bw, maxh;
+    double dt, B, d, ad, sc, off, s, t = now / 1000000.0, pitch, amp;
+    SDL_Rect sk, vo, tile, bar;
+    char name[320], num[48];
+    int al, md, have, b0, b1, q, mid, chh, nal;
+    float wv[UI_WAVE_N];
+
+    if (!ui_flow_on(is) || W < 260 || H < 200) {
+        ui_flow_n = 0;
+        ui_flow_moving = 0;
+        ui_tp_stop();
+        return;
+    }
+    if (ui_tv_on(is)) {                         /* v37: the tiled view draws instead */
+        ui_tv_draw(is);
+        return;
+    }
+    ui_flow_vmode = ui_flow_video(is);          /* over a video: tiles in their own shape, no disc */
+    if (!ui_flow_vmode) {                       /* an audio item shows the queue view: a video that follows keeps it (L goes to the full screen video) */
+        ui_vflow = 1;
+        ui_vflow_p = 1.0;
+        ui_vflow_ep = 1.0;
+    }
+    ui_tp_tick(is);
+    if (now - ui_tile_seen > 350000)
+        ui_tile_born = now;                     /* the view has just opened: the tiles glide in */
+    ui_tile_seen = now;
+    if (ui_hov_x >= 0 && !ui_flow_dragging && !ui_menu_open && !ui_prefs_open)
+        hov_i = ui_flow_cover_at(is, ui_hov_x, ui_hov_y);
+    dt = ui_flow_t ? av_clipd((now - ui_flow_t) / 1000000.0, 0.0, 0.1) : 0.0;
+    ui_flow_t = now;
+    {                                           /* the video shrinks into its tile (or grows back) smoothly when L is pressed */
+        double want = ui_vflow ? 1.0 : 0.0, dtv = ui_vflow_t ? av_clipd((now - ui_vflow_t) / 1000000.0, 0.0, 0.1) : 0.0;
+
+        ui_vflow_t = now;
+        ui_vflow_p += (want - ui_vflow_p) * (1.0 - exp(-dtv * (want > 0.5 ? 8.0 : 12.0)));      /* growing back is quicker */
+        if (fabs(want - ui_vflow_p) < 0.004)
+            ui_vflow_p = want;
+        ui_vflow_ep = ui_vflow_p * ui_vflow_p * (3.0 - 2.0 * ui_vflow_p);
+    }
+    if (q_pos != ui_flow_last_q) {              /* a new item started: the row glides to it */
+        ui_flow_last_q = q_pos;
+        ui_flow_target = q_pos;
+        ui_flow_touch = 0;
+    }
+                                                /* the row stays where it was swiped to until a tap outside the tiles */
+    ui_flow_target = av_clip(ui_flow_target, 0, q_count - 1);
+    ui_flow_pos += (ui_flow_target - ui_flow_pos) * (1.0 - exp(-dt * 10.0));
+    ui_flow_moving = fabs(ui_flow_target - ui_flow_pos) > 0.003;
+    if (!ui_flow_moving)
+        ui_flow_pos = ui_flow_target;
+    if (ui_vflow_p != (ui_vflow ? 1.0 : 0.0))
+        ui_flow_moving = 1;                     /* the video is still shrinking into its tile, or growing back: keep drawing */
+    if (!is->paused)
+        ui_flow_ang = fmod(ui_flow_ang + dt * 0.9, 6.28318531);        /* about one turn every 7 seconds */
+    lvl += ((is->paused ? 0.0f : av_clipf(is->level * 4.0f, 0.0f, 1.0f)) - lvl) * 0.25f;
+    if (now - eq_at > 45000 || now < eq_at) {
+        memmove(eq, eq + 1, sizeof(float) * (NEQ - 1));
+        eq[NEQ - 1] = lvl;
+        eq_at = now;
+    }
+
+    SDL_SetRenderDrawBlendMode(renderer, SDL_BLENDMODE_BLEND);
+    {                                           /* video tiles: as big as the window allows (a wide picture fills the width, a tall one the height) */
+        double ar = 1.0;
+
+        if (ui_flow_vmode && is->video_st && is->video_st->codecpar->height > 0)
+            ar = av_clipd((double)is->video_st->codecpar->width / is->video_st->codecpar->height, 1.0, 1.8);
+        B = ui_flow_vmode ? FFMIN(W * 0.52, H * 0.58 * ar) : FFMIN(W * 0.30, H * 0.44);
+    }
+    cx = W / 2 - (ui_flow_vmode ? 0 : (int)(B * 0.12));
+    chh = (int)B;                               /* the height of the middle tile */
+    cy = (int)(H * (ui_flow_vmode ? 0.38 : 0.40));
+    ui_flow_n = 0;
+    ci = av_clip((int)(ui_flow_pos + 0.5), 0, q_count - 1);
+
+    {
+        SDL_Rect ui_flow_rects[11], cut, dcl;
+        double tl[11];
+        int ok[11];
+
+        for (i = ci - 5; i <= ci + 5; i++) {    /* first, where every cover sits */
+            int e = i - (ci - 5);
+
+            ok[e] = i >= 0 && i < q_count;
+            if (!ok[e])
+                continue;
+            d = i - ui_flow_pos;
+            ad = fabs(d);
+            sc = 1.0 - ((ui_flow_vmode && i != q_pos && ui_cov_aspect(q_items[i]) > 0.0) ? 0.16 : 0.40) * FFMIN(ad, 1.0) -
+                 0.06 * FFMAX(FFMIN(ad, 3.0) - 1.0, 0.0);
+            off = ui_flow_off(B, d);
+            if (ui_flow_vmode && i != q_pos) {  /* the other tiles slide out from behind the video and grow a little */
+                off *= 0.55 + 0.45 * ui_vflow_ep;
+                sc *= 0.8 + 0.2 * ui_vflow_ep;
+            }
+            s = ui_flow_slot(i, B, W, H) * sc;
+            tl[e] = av_clipd(d, -1.0, 1.0) * (0.45 + 1.1 * fmod(i * 0.61803398875 + 0.3, 1.0));    /* each cover turns a little differently */
+            if (ui_flow_vmode)
+                tl[e] = -tl[e];                 /* over a video the row is convex: the edge nearest the middle is the tall one, like the outside of a cylinder */
+            ui_flow_rects[e].w = (int)(s * (1.0 - 0.14 * fabs(tl[e])));         /* a turned cover is narrower */
+            ui_flow_rects[e].h = (int)s;
+            ui_flow_rects[e].x = cx + (int)(off - s / 2);
+            if (d < 0)
+                ui_flow_rects[e].x += (int)s - ui_flow_rects[e].w;              /* the edge nearest the middle stays put */
+            ui_flow_rects[e].y = cy - (int)(s / 2);
+            {                                   /* a video keeps its own shape (whatever is playing): fitted into the square slot, centred in it */
+                int sw = ui_flow_rects[e].w, sh = ui_flow_rects[e].h, nw, nh;
+
+                ui_flow_fit(i, sw, sh, &nw, &nh);
+                ui_flow_rects[e].x += (sw - nw) / 2;
+                ui_flow_rects[e].y += (sh - nh) / 2;
+                ui_flow_rects[e].w = nw;
+                ui_flow_rects[e].h = nh;
+            }
+        }
+        {                                       /* the labels and bars go under the middle picture: its height is eased between the two nearest items, so they do not jump */
+            int i0 = av_clip((int)floor(ui_flow_pos), 0, q_count - 1), i1 = FFMIN(i0 + 1, q_count - 1), pw, h0, h1;
+            double f = av_clipd(ui_flow_pos - i0, 0.0, 1.0);
