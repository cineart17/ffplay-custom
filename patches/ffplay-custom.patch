+
+    {                                           /* the bars are always shown, from the left of the window to the right */
+        int lab_w = W >= 520 ? 56 : 0, x0 = 24 + lab_w, span = W - 48 - 2 * lab_w, bars_ok = 1;        /* where the bars start, and how wide they spread */
+
+        ui_layout(is, &sk, &vo);
