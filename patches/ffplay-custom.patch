+static void ui_prefs_draw(void)
+{
+    SDL_Rect p, sw;
+    char value[48];
+    int ww, wh, i, cy, x_right, vw, vx;
+    double e, se, k, dt, wt;
+    static int64_t last = 0;
+    int64_t now = av_gettime_relative();
+
+    if (!ui_prefs_open) {
+        for (i = 0; i < UI_PREF_ROWS; i++)
+            ui_pref_open[i] = 0.0;
+        memset(ui_pref_pop, 0, sizeof(ui_pref_pop));
+        ui_prefs_anim = 0;
+        ui_prefs_w = 600.0;
+        return;
+    }
+    dt = now - last > 100000 ? 0.016 : (now - last) / 1000000.0;
+    last = now;
+    ui_prefs_anim = 0;
+    for (i = 0; i < UI_PREF_ROWS; i++) {        /* the rows glide toward their choices, or back */
+        double tgt = i == ui_prefs_hover ? 1.0 : 0.0;
+
+        ui_pref_open[i] += (tgt - ui_pref_open[i]) * (1.0 - exp(-dt / 0.07));
+        if (fabs(tgt - ui_pref_open[i]) < 0.005)
+            ui_pref_open[i] = tgt;
+        else
+            ui_prefs_anim = 1;
+    }
+    SDL_GetWindowSize(window, &ww, &wh);
+    wt = 600.0;                                 /* the panel grows if the name and the choices of the row under the mouse need more */
+    if (ui_prefs_hover >= 0 && ui_prefs_hover < UI_PREF_ROWS)
+        wt = FFMAX(wt, ui_pref_need_w(ui_prefs_hover));
+    wt = FFMIN(wt, ww - 16);
+    ui_prefs_w += (wt - ui_prefs_w) * (1.0 - exp(-dt / 0.09));
+    if (fabs(wt - ui_prefs_w) < 0.6)
+        ui_prefs_w = wt;
+    else
+        ui_prefs_anim = 1;
+    p = ui_prefs_rect(ww, wh);
+    ui_glass(&p, 28);
+    x_right = p.x + p.w - ui_pr_mg;
+
+    SDL_SetRenderDrawBlendMode(renderer, SDL_BLENDMODE_BLEND);
+    ui_label(p.x + ui_pr_mg, p.y + UI_PREF_HEAD / 2 + 4, "Preferences", ui_pr_tpx, 245, 245, 245, 255);
+    for (i = 0; i < UI_PREF_ROWS; i++) {
+        cy = p.y + UI_PREF_HEAD + i * UI_PREF_ROW + UI_PREF_ROW / 2;
+        e = ui_pref_open[i];
+        se = e * e * (3.0 - 2.0 * e);
+        k = 1.0 - se;                           /* how much of the value is still showing */
+        {
+            static const int pic[UI_PREF_ROWS] = { UI_IC_SKIP, UI_IC_VOLUME, UI_IC_EYE, UI_IC_EXPAND, UI_IC_DROP,
+                                                   UI_IC_BOOKMARK, UI_IC_EXIT, UI_IC_MOUSE };
+
+            ui_icon(pic[i], p.x + ui_pr_mg + (int)(10 * se), cy, av_clip(ui_pr_px, 14, 22), 245, 245, 245,
+                    i == ui_prefs_hover ? 255 : 170);
+        }
+        ui_label(p.x + ui_pr_mg + UI_PREF_ICW + (int)(10 * se), cy, ui_pref_name[i], ui_pr_px, 245, 245, 245,
+                 i == ui_prefs_hover ? 255 : 210);      /* the name nudges a little to make room, like a volume bar coming in from the side */
+
+        if (k > 0.01) {
+            ui_pref_value(i, value, sizeof(value));
+            vw = ui_text_width(value, ui_pr_px);
+            vx = x_right - vw;
+            if (i == 4) {
+                sw.x = vx - 26;                 /* a dot in the chosen color */
+                sw.y = cy - 8;
+                sw.w = 16;
+                sw.h = 16;
+                SDL_SetRenderDrawColor(renderer, cfg_bar_r, cfg_bar_g, cfg_bar_b, (int)(255 * k));
+                ui_pill(&sw);
+            }
+            if (!ui_pref_arrows(i) && !strcmp(value, "Off"))
+                ui_label(vx, cy, value, ui_pr_px, 150, 150, 150, (int)(255 * k));
+            else
+                ui_label(vx, cy, value, ui_pr_px, 245, 245, 245, (int)(255 * k));
+        }
+
+        if (e > 0.01) {                         /* the choices squeeze in from the right margin, beside the name */
+            SDL_Rect r[10];
+            const char *names[10];
+            char store[10][20];
+            int n, c, sel, px, hot;
+
+            n = ui_pref_layout(i, &p, cy, r, names, store, &sel, &px);
+            for (c = 0; c < n; c++) {
+                double cxc = r[c].x + r[c].w / 2.0, cx, sc;
+
+                sc = av_clipd(se * 1.5 - 0.5 * (n - 1 - c) / FFMAX(n - 1, 1), 0.0, 1.0);   /* the choice at the margin first, then the next */
+                sc = sc * sc * (3.0 - 2.0 * sc);
+                cx = cxc + (1.0 - sc) * 34.0;           /* each one slides in from the side while it fades in */
+                hot = i == ui_prefs_hover && ui_prefs_mx >= r[c].x && ui_prefs_mx < r[c].x + r[c].w &&
+                      ui_prefs_my >= r[c].y && ui_prefs_my < r[c].y + r[c].h;
+                {                               /* no box under it: the choice the mouse is on rises a little and gets brighter */
+                    int mv = 0, ly;
+                    double pe = ui_pop_step(&ui_pref_pop[i][c], hot, dt, &mv);
+
+                    if (mv)
+                        ui_prefs_anim = 1;
+                    ly = cy - (int)(UI_POP * pe + 0.5);
+                    if (c == sel)               /* the choice that is on: in the bar color */
+                        ui_label_c((int)cx, ly, names[c], px, av_clip(cfg_bar_r + 40 + (int)(30 * pe), 0, 255),
+                                   av_clip(cfg_bar_g + 40 + (int)(30 * pe), 0, 255), av_clip(cfg_bar_b + 40 + (int)(30 * pe), 0, 255),
+                                   (int)(255 * sc));
+                    else
+                        ui_label_c((int)cx, ly, names[c], px, 215 + (int)(40 * pe), 215 + (int)(40 * pe), 215 + (int)(40 * pe),
+                                   (int)((165 + 90 * pe) * sc));
+                }
+            }
+        }
+    }
+    if (UI_PREF_FOOT >= 30)
+        ui_label(p.x + ui_pr_mg, p.y + p.h - UI_PREF_FOOT / 2, "Move the mouse onto a setting to see its choices.  Esc closes.",
+             15, 170, 170, 170, 255);
+}
