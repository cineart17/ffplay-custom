+static UiPkEnt *ui_pk_push(UiPkEnt **arr, int *n, int *cap)
+{
+    if (*n >= *cap) {
+        int nc = *cap ? *cap * 2 : 256;
+        UiPkEnt *ne = realloc(*arr, nc * sizeof(**arr));
+
+        if (!ne)
+            return NULL;
+        *arr = ne;
+        *cap = nc;
+    }
+    memset(&(*arr)[*n], 0, sizeof(**arr));
+    return &(*arr)[(*n)++];
+}
