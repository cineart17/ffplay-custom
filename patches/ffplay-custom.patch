+    ui_flow_mx = x;
+    ui_flow_my = y;
+    is->force_refresh = 1;
+    return 1;
+}
+
+/* The mouse came up: drop the cover where the marker is, or, if it never moved, play it (or pause / resume) */
+static int ui_flow_release(VideoState *is, int x, int y)
+{
+    int idx = ui_flow_press;
